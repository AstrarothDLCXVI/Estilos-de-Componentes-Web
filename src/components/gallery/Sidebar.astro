---
import { catalog, hrefFor, totalDesigns } from '@/lib/registry';

interface Props {
  activeSlug: string;
}

const { activeSlug } = Astro.props;
---

<aside class="sidebar">
  <a class="brand" href="/">
    <span class="brand-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
        <rect x="3" y="3" width="7.5" height="7.5" rx="1.6"></rect>
        <rect x="13.5" y="3" width="7.5" height="7.5" rx="3.75"></rect>
        <rect x="3" y="13.5" width="7.5" height="7.5" rx="3.75"></rect>
        <rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.6"></rect>
      </svg>
    </span>
    <span class="brand-text">
      <strong>Component Gallery</strong>
      <span class="brand-meta">{totalDesigns} variantes</span>
    </span>
  </a>

  <nav class="nav" aria-label="Categorías de componentes">
    <p class="nav-title">Catálogo</p>
    <ul role="list" class="nav-list">
      {
        catalog.map((category) => (
          <li>
            <a
              class="nav-link"
              href={hrefFor(category.slug)}
              aria-current={category.slug === activeSlug ? 'page' : undefined}
            >
              <span class="nav-label">{category.label}</span>
              <span class="nav-count">{category.designs.length}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <p class="nav-hint">
    Para añadir una categoría: crea su carpeta en <code>src/components/designs/</code> y
    decláralas en <code>src/data/catalog.ts</code>.
  </p>
</aside>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    display: flex;
    height: 100vh;
    flex-direction: column;
    gap: 28px;
    border-right: 1px solid var(--app-line);
    background: var(--app-surface);
    padding: 20px 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 6px 8px;
    border-radius: var(--radius-md);
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 34px;
    height: 34px;
    flex: none;
    place-items: center;
    border-radius: 10px;
    background: var(--primary-color);
    color: var(--primary-contrast);
    transition: background-color var(--speed) var(--ease);
  }

  .brand-mark svg {
    width: 19px;
    height: 19px;
  }

  .brand-text {
    display: flex;
    min-width: 0;
    flex-direction: column;
    line-height: 1.25;
  }

  .brand-text strong {
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand-meta {
    color: var(--app-faint);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .nav-title {
    margin: 0 8px 10px;
    color: var(--app-faint);
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    list-style: none;
    padding: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 9px 10px 9px 12px;
    border-radius: var(--radius-sm);
    color: var(--app-muted);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: background-color var(--speed) var(--ease), color var(--speed) var(--ease);
  }

  .nav-link:hover {
    background: var(--app-sunken);
    color: var(--app-text);
  }

  .nav-link[aria-current='page'] {
    background: var(--primary-soft);
    color: var(--app-text);
    box-shadow: inset 2px 0 0 var(--primary-color);
  }

  .nav-count {
    color: var(--app-faint);
    font-family: var(--font-mono);
    font-size: 11.5px;
  }

  .nav-hint {
    margin-top: auto;
    border-top: 1px solid var(--app-line);
    padding: 14px 8px 4px;
    color: var(--app-faint);
    font-size: 11.5px;
    line-height: 1.6;
  }

  .nav-hint code {
    color: var(--app-muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  /* En móvil el sidebar pasa a ser una fila de chips desplazable. */
  @media (max-width: 900px) {
    .sidebar {
      position: static;
      height: auto;
      flex-direction: row;
      align-items: center;
      gap: 14px;
      border-right: 0;
      border-bottom: 1px solid var(--app-line);
      padding: 12px 16px;
    }

    .brand-text,
    .nav-title,
    .nav-hint {
      display: none;
    }

    .nav {
      min-width: 0;
      flex: 1;
    }

    .nav-list {
      flex-direction: row;
      overflow-x: auto;
      padding-bottom: 2px;
      scrollbar-width: none;
    }

    .nav-list::-webkit-scrollbar {
      display: none;
    }

    .nav-link {
      border: 1px solid var(--app-line);
      border-radius: var(--radius-full);
      padding: 7px 14px;
      white-space: nowrap;
    }

    .nav-link[aria-current='page'] {
      border-color: var(--primary-line);
      box-shadow: none;
    }
  }
</style>
