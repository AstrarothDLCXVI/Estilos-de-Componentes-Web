---
import { allCategories, catalog, hrefFor, totalDesigns } from '@/lib/registry';
import type { CategoryEntry } from '@/lib/types';

interface Props {
  activeSlug: string;
}

const { activeSlug } = Astro.props;

// "Componentes": categorías sueltas, sin `group` (headers, cards, hero...).
const components = catalog.filter((category) => !category.group);

// "Páginas web": TODA la taxonomía declarada, agrupada por `group`, tenga o
// no diseños todavía. Las que no tienen ningún fichero se listan igual,
// marcadas como "Próximamente" (ver registry.ts: `allCategories` vs `catalog`).
interface PageGroup {
  label: string;
  items: CategoryEntry[];
}

const pageGroups = allCategories.reduce<PageGroup[]>((groups, category) => {
  if (!category.group) return groups;
  let bucket = groups.find((g) => g.label === category.group);
  if (!bucket) {
    bucket = { label: category.group, items: [] };
    groups.push(bucket);
  }
  bucket.items.push(category);
  return groups;
}, []);

const totalPageTypes = pageGroups.reduce((sum, g) => sum + g.items.length, 0);
const builtPageTypes = pageGroups.reduce((sum, g) => sum + g.items.filter((i) => i.designs.length > 0).length, 0);
const activeGroup = pageGroups.find((g) => g.items.some((i) => i.slug === activeSlug));
---

<aside class="sidebar">
  <a class="brand" href="/">
    <span class="brand-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
        <rect x="3" y="3" width="7.5" height="7.5" rx="1.6"></rect>
        <rect x="13.5" y="3" width="7.5" height="7.5" rx="3.75"></rect>
        <rect x="3" y="13.5" width="7.5" height="7.5" rx="3.75"></rect>
        <rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.6"></rect>
      </svg>
    </span>
    <span class="brand-text">
      <strong>Component Gallery</strong>
      <span class="brand-meta">{totalDesigns} variantes</span>
    </span>
  </a>

  <nav class="nav" aria-label="Componentes">
    <p class="nav-title">Componentes</p>
    <ul role="list" class="nav-list">
      {
        components.map((category) => (
          <li>
            <a
              class="nav-link"
              href={hrefFor(category.slug)}
              aria-current={category.slug === activeSlug ? 'page' : undefined}
            >
              <span class="nav-label">{category.label}</span>
              <span class="nav-count">{category.designs.length}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <nav class="nav nav-pages" aria-label="Páginas web">
    <p class="nav-title">
      Páginas web
      <span class="nav-title-count">
        {builtPageTypes}/{totalPageTypes}
      </span>
    </p>

    <div class="groups">
      {
        pageGroups.map((group) => {
          const builtInGroup = group.items.filter((i) => i.designs.length > 0).length;
          return (
            <details class="group" open={group === activeGroup}>
              <summary>
                <span class="group-label">{group.label}</span>
                <span class="group-right">
                  <span class="group-count">
                    {builtInGroup}/{group.items.length}
                  </span>
                  <svg class="group-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="m6 4 4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </summary>

              <ul role="list" class="group-list">
                {group.items.map((item) =>
                  item.designs.length > 0 ? (
                    <li>
                      <a
                        class="nav-link nav-link-sub"
                        href={hrefFor(item.slug)}
                        aria-current={item.slug === activeSlug ? 'page' : undefined}
                      >
                        {item.label}
                      </a>
                    </li>
                  ) : (
                    <li>
                      <span class="is-soon">
                        {item.label}
                        <em>Próximamente</em>
                      </span>
                    </li>
                  ),
                )}
              </ul>
            </details>
          );
        })
      }
    </div>
  </nav>

  <p class="nav-hint">
    Para ampliar la galería: crea la carpeta en <code>src/components/designs/</code> y decláralo en{' '}
    <code>src/data/catalog.ts</code>.
  </p>
</aside>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    display: flex;
    height: 100vh;
    flex-direction: column;
    gap: 24px;
    overflow-y: auto;
    border-right: 1px solid var(--app-line);
    background: var(--app-surface);
    padding: 20px 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 6px 8px;
    border-radius: var(--radius-md);
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 34px;
    height: 34px;
    flex: none;
    place-items: center;
    border-radius: 10px;
    background: var(--primary-color);
    color: var(--primary-contrast);
    transition: background-color var(--speed) var(--ease);
  }

  .brand-mark svg {
    width: 19px;
    height: 19px;
  }

  .brand-text {
    display: flex;
    min-width: 0;
    flex-direction: column;
    line-height: 1.25;
  }

  .brand-text strong {
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand-meta {
    color: var(--app-faint);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .nav-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin: 0 8px 10px;
    color: var(--app-faint);
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .nav-title-count {
    letter-spacing: 0;
    text-transform: none;
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    list-style: none;
    padding: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 9px 10px 9px 12px;
    border-radius: var(--radius-sm);
    color: var(--app-muted);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: background-color var(--speed) var(--ease), color var(--speed) var(--ease);
  }

  .nav-link:hover {
    background: var(--app-sunken);
    color: var(--app-text);
  }

  .nav-link[aria-current='page'] {
    background: var(--primary-soft);
    color: var(--app-text);
    box-shadow: inset 2px 0 0 var(--primary-color);
  }

  .nav-count {
    color: var(--app-faint);
    font-family: var(--font-mono);
    font-size: 11.5px;
  }

  /* --- Páginas web: grupos plegables --- */
  .groups {
    display: grid;
    gap: 1px;
  }

  .group summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 10px 8px 12px;
    border-radius: var(--radius-sm);
    color: var(--app-text);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: -0.005em;
    list-style: none;
    cursor: pointer;
    transition: background-color var(--speed) var(--ease);
  }

  .group summary::-webkit-details-marker {
    display: none;
  }

  .group summary:hover {
    background: var(--app-sunken);
  }

  .group-right {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .group-count {
    color: var(--app-faint);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .group-chevron {
    width: 11px;
    height: 11px;
    color: var(--app-faint);
    transition: transform var(--speed) var(--ease);
  }

  .group[open] .group-chevron {
    transform: rotate(90deg);
  }

  .group-list {
    display: grid;
    gap: 1px;
    margin: 2px 0 6px;
    padding-left: 8px;
    list-style: none;
  }

  .nav-link-sub {
    padding: 6px 10px 6px 14px;
    font-size: 12.5px;
  }

  .is-soon {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 6px 10px 6px 14px;
    color: var(--app-faint);
    font-size: 12.5px;
    cursor: default;
  }

  .is-soon em {
    flex: none;
    border-radius: 999px;
    background: var(--app-sunken);
    padding: 1px 7px;
    color: var(--app-faint);
    font-size: 9px;
    font-style: normal;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .nav-hint {
    margin-top: auto;
    border-top: 1px solid var(--app-line);
    padding: 14px 8px 4px;
    color: var(--app-faint);
    font-size: 11.5px;
    line-height: 1.6;
  }

  .nav-hint code {
    color: var(--app-muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  /* En móvil: marca + componentes en una fila horizontal; "Páginas web" pasa
     a ocupar su propia fila completa debajo, en flujo vertical normal. */
  @media (max-width: 900px) {
    .sidebar {
      position: static;
      height: auto;
      flex-flow: row wrap;
      align-items: center;
      gap: 14px 14px;
      border-right: 0;
      border-bottom: 1px solid var(--app-line);
      padding: 12px 16px;
    }

    .brand-text,
    .nav-title,
    .nav-hint {
      display: none;
    }

    .nav {
      min-width: 0;
      flex: 1;
    }

    .nav-list {
      flex-direction: row;
      overflow-x: auto;
      padding-bottom: 2px;
      scrollbar-width: none;
    }

    .nav-list::-webkit-scrollbar {
      display: none;
    }

    .nav-link {
      border: 1px solid var(--app-line);
      border-radius: var(--radius-full);
      padding: 7px 14px;
      white-space: nowrap;
    }

    .nav-link[aria-current='page'] {
      border-color: var(--primary-line);
      box-shadow: none;
    }

    .nav-pages {
      flex: 1 0 100%;
      order: 10;
    }
  }
</style>
