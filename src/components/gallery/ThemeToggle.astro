---
// El tema afecta a la carcasa Y al lienzo de previsualización: sirve para
// comprobar que un mismo diseño se sostiene en claro y en oscuro.
---

<button type="button" class="toggle" data-theme-toggle aria-pressed="false">
  <span class="visually-hidden">Cambiar entre tema claro y oscuro</span>
  <svg class="icon icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"></path>
  </svg>
  <svg class="icon icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
    <path d="M20 14.5A8.2 8.2 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  if (toggle) {
    const sync = () => {
      const isDark = document.documentElement.dataset.theme === 'dark';
      toggle.setAttribute('aria-pressed', String(isDark));
    };

    sync();

    toggle.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      window.__gallery.applyTheme(next);
      sync();
    });
  }
</script>

<style>
  .toggle {
    display: grid;
    width: 38px;
    height: 38px;
    flex: none;
    place-items: center;
    border: 1px solid var(--app-line);
    border-radius: var(--radius-full);
    background: var(--app-surface);
    color: var(--app-muted);
    transition: color var(--speed) var(--ease), border-color var(--speed) var(--ease);
  }

  .toggle:hover {
    border-color: var(--app-line-strong);
    color: var(--app-text);
  }

  .icon {
    grid-area: 1 / 1;
    width: 17px;
    height: 17px;
    transition: opacity var(--speed) var(--ease), transform var(--speed) var(--ease);
  }

  .icon-moon,
  .toggle[aria-pressed='true'] .icon-sun {
    opacity: 0;
    transform: rotate(-40deg) scale(0.7);
  }

  .icon-sun,
  .toggle[aria-pressed='true'] .icon-moon {
    opacity: 1;
    transform: rotate(0) scale(1);
  }
</style>
