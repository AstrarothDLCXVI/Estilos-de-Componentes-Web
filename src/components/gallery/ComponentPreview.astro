---
import type { DesignEntry } from '@/lib/types';

interface Props {
  design: DesignEntry;
}

const { design } = Astro.props;
const codeId = `source-${design.id.replace('/', '-')}`;
---

<article class="specimen">
  <div class="rail">
    <span class="rail-id">
      <span class="rail-dot" aria-hidden="true"></span>
      {design.code}
    </span>
    <span class="rail-file">{design.fileName}.astro</span>

    <div class="rail-actions">
      <button type="button" class="action" data-code-toggle aria-expanded="false" aria-controls={codeId}>
        Ver código
      </button>
      <button type="button" class="action" data-copy={codeId}>Copiar</button>
    </div>
  </div>

  <header class="head">
    <h3 class="head-title">{design.name}</h3>
    <p class="head-text">{design.description}</p>
    {
      design.tags && design.tags.length > 0 && (
        <ul role="list" class="tags">
          {design.tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      )
    }
  </header>

  <div class="preview-canvas">
    <div class="preview-canvas-inner">
      <slot />
    </div>
  </div>

  <div class="code" id={codeId} hidden>
    <pre><code>{design.source}</code></pre>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-code-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const panel = document.getElementById(button.getAttribute('aria-controls') ?? '');
      if (!panel) return;

      const willOpen = panel.hasAttribute('hidden');
      panel.toggleAttribute('hidden', !willOpen);
      button.setAttribute('aria-expanded', String(willOpen));
      button.textContent = willOpen ? 'Ocultar código' : 'Ver código';
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const source = document.getElementById(button.dataset.copy ?? '')?.textContent ?? '';
      const original = button.textContent;

      try {
        await navigator.clipboard.writeText(source);
        button.textContent = 'Copiado';
      } catch {
        button.textContent = 'No se pudo copiar';
      }

      window.setTimeout(() => {
        button.textContent = original;
      }, 1600);
    });
  });
</script>

<style>
  .specimen {
    overflow: hidden;
    border: 1px solid var(--app-line);
    border-radius: var(--radius-lg);
    background: var(--app-surface);
    box-shadow: var(--app-shadow);
  }

  .rail {
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid var(--app-line);
    background: var(--app-sunken);
    padding: 9px 14px;
    font-family: var(--font-mono);
    font-size: 11.5px;
  }

  .rail-id {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .rail-dot {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
    background: var(--primary-color);
    transition: background-color var(--speed) var(--ease);
  }

  .rail-file {
    color: var(--app-faint);
  }

  .rail-actions {
    display: flex;
    gap: 6px;
    margin-left: auto;
  }

  .action {
    border: 1px solid var(--app-line-strong);
    border-radius: var(--radius-sm);
    background: var(--app-surface);
    padding: 4px 10px;
    color: var(--app-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    transition: color var(--speed) var(--ease), border-color var(--speed) var(--ease);
  }

  .action:hover {
    border-color: var(--primary-color);
    color: var(--app-text);
  }

  .head {
    padding: 18px 22px 16px;
  }

  .head-title {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .head-text {
    max-width: 62ch;
    margin-top: 5px;
    color: var(--app-muted);
    font-size: 13.5px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 12px 0 0;
    list-style: none;
    padding: 0;
  }

  .tag {
    border: 1px solid var(--app-line);
    border-radius: var(--radius-full);
    padding: 3px 9px;
    color: var(--app-muted);
    font-size: 11.5px;
  }

  .preview-canvas {
    border-top: 1px solid var(--app-line);
    padding: 26px 22px;
    /* Tablero sutil: deja claro dónde acaba el diseño y empieza la galería. */
    background-image: radial-gradient(
      color-mix(in srgb, var(--text-color) 9%, transparent) 1px,
      transparent 1px
    );
    background-size: 16px 16px;
  }

  .code {
    border-top: 1px solid var(--app-line);
    background: var(--app-sunken);
  }

  .code pre {
    overflow-x: auto;
    max-height: 460px;
    margin: 0;
    padding: 18px 22px;
    color: var(--app-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.65;
    tab-size: 2;
  }

  @media (max-width: 640px) {
    .rail-file {
      display: none;
    }

    .head {
      padding: 16px;
    }

    .preview-canvas {
      padding: 16px 12px;
    }
  }
</style>
