---
// Red social autocontenida: topbar, sidebar de navegación, feed central con
// publicaciones y barra de sugerencias. Fotos e imágenes de publicación son
// degradados en CSS teñidos con el color principal.
const navItems = [
  { label: 'Inicio', active: true },
  { label: 'Explorar', active: false },
  { label: 'Notificaciones', active: false },
  { label: 'Mensajes', active: false },
  { label: 'Guardado', active: false },
];

const posts = [
  {
    author: 'Marta Iglesias',
    handle: '@martaiglesias',
    initials: 'MI',
    time: '2 h',
    text: 'Primer boceto del sistema de color nuevo. El contraste en modo oscuro por fin no da miedo.',
    tone: 0.2,
    hasPhoto: true,
    likes: 128,
    comments: 14,
  },
  {
    author: 'Diego Correa',
    handle: '@diegocorrea',
    initials: 'DC',
    time: '5 h',
    text: 'Reducir el bundle un 30 % moviendo tres dependencias a carga diferida. A veces la optimización más aburrida es la que más se nota.',
    tone: 0.6,
    hasPhoto: false,
    likes: 76,
    comments: 9,
  },
  {
    author: 'Sara Peña',
    handle: '@sarapena',
    initials: 'SP',
    time: '1 d',
    text: 'Ocho entrevistas de usuario esta semana. El patrón se repite: nadie lee el onboarding, todos abren el menú de ayuda.',
    tone: 0.9,
    hasPhoto: true,
    likes: 214,
    comments: 31,
  },
];

const trends = [
  { tag: '#DesignSystems', posts: '12,4 K publicaciones' },
  { tag: '#AstroJS', posts: '8,1 K publicaciones' },
  { tag: '#ColorMix', posts: '3,7 K publicaciones' },
];

const suggestions = [
  { name: 'Clara Ferrer', handle: '@claraferrer', initials: 'CF' },
  { name: 'Iván Bermúdez', handle: '@ivanbermudez', initials: 'IB' },
];
---

<div class="app">
  <header class="topbar">
    <a class="logo" href="#">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="8"></circle>
        <path d="M12 8v4l3 2"></path>
      </svg>
      Órbita
    </a>

    <label class="search">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <circle cx="7" cy="7" r="4.3"></circle>
        <path d="m13 13-2.6-2.6" stroke-linecap="round"></path>
      </svg>
      <span class="visually-hidden">Buscar</span>
      <input type="search" placeholder="Buscar en Órbita" />
    </label>

    <span class="avatar" aria-hidden="true">TÚ</span>
  </header>

  <div class="body">
    <aside class="sidebar">
      <nav aria-label="Principal">
        <ul role="list">
          {
            navItems.map((item) => (
              <li>
                <a class={item.active ? 'is-active' : ''} href="#">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <a class="btn-solid" href="#">Publicar</a>
    </aside>

    <main class="feed">
      <div class="composer">
        <span class="avatar" aria-hidden="true">TÚ</span>
        <input type="text" placeholder="¿Qué estás pensando?" />
      </div>

      {
        posts.map((post) => (
          <article class="post">
            <span class="avatar" aria-hidden="true">
              {post.initials}
            </span>
            <div class="post-body">
              <p class="post-head">
                <strong>{post.author}</strong>
                <span>{post.handle}</span>
                <span class="dot" aria-hidden="true" />
                <span>{post.time}</span>
              </p>
              <p class="post-text">{post.text}</p>
              {post.hasPhoto && <div class="post-photo photo-tone" style={`--tone:${post.tone}`} aria-hidden="true" />}
              <div class="post-actions">
                <button type="button">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                    <path d="M8 13.5S2 10 2 6a3 3 0 0 1 6-1.2A3 3 0 0 1 14 6c0 4-6 7.5-6 7.5Z" stroke-linejoin="round" />
                  </svg>
                  {post.likes}
                </button>
                <button type="button">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                    <path d="M2.5 3.5h11v7.5h-6L4 13.5v-2.5H2.5Z" stroke-linejoin="round" />
                  </svg>
                  {post.comments}
                </button>
                <button type="button" aria-label="Compartir">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                    <path d="M4.5 9.5 11.5 5m-7 4-2 5.5L14 8 5.7 2 4 6.7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
              </div>
            </div>
          </article>
        ))
      }
    </main>

    <aside class="rail">
      <div class="rail-panel">
        <h2>Tendencias para ti</h2>
        <ul role="list">
          {
            trends.map((trend) => (
              <li>
                <a href="#">{trend.tag}</a>
                <span>{trend.posts}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="rail-panel">
        <h2>A quién seguir</h2>
        <ul role="list" class="suggestions">
          {
            suggestions.map((person) => (
              <li>
                <span class="avatar" aria-hidden="true">
                  {person.initials}
                </span>
                <div>
                  <strong>{person.name}</strong>
                  <span>{person.handle}</span>
                </div>
                <button type="button">Seguir</button>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </div>
</div>

<style>
  .app {
    background: var(--background-color);
    font-family: var(--font-sans);
  }

  .photo-tone {
    position: relative;
    overflow: hidden;
    background: linear-gradient(
      calc((130 + var(--tone) * 80) * 1deg),
      color-mix(in srgb, var(--primary-color) 88%, #000 4%),
      color-mix(in srgb, var(--primary-color) 30%, var(--surface-alt))
    );
  }

  /* --- Topbar --- */
  .topbar {
    display: flex;
    align-items: center;
    gap: 20px;
    border-bottom: 1px solid var(--border-color);
    background: var(--surface-color);
    padding: 12px 24px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-color);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .logo svg {
    width: 20px;
    height: 20px;
    color: var(--primary-color);
  }

  .search {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    max-width: 340px;
    margin-inline: auto;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--surface-alt);
    padding: 7px 14px;
    color: var(--text-muted);
    transition: border-color 180ms ease;
  }

  .search:focus-within {
    border-color: var(--primary-color);
  }

  .search svg {
    width: 15px;
    height: 15px;
    flex: none;
  }

  .search input {
    min-width: 0;
    flex: 1;
    border: 0;
    background: none;
    color: var(--text-color);
    font-size: 13px;
    outline: none;
  }

  .avatar {
    display: grid;
    width: 34px;
    height: 34px;
    flex: none;
    place-items: center;
    border-radius: 999px;
    background: var(--primary-light);
    color: color-mix(in srgb, var(--primary-color) 72%, var(--text-color));
    font-size: 11px;
    font-weight: 700;
  }

  /* --- Body / 3 columnas --- */
  .body {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) 260px;
  }

  /* --- Sidebar --- */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 20px;
    border-right: 1px solid var(--border-color);
    padding: 20px 14px;
  }

  .sidebar nav ul {
    display: grid;
    gap: 2px;
    margin: 0;
    list-style: none;
    padding: 0;
  }

  .sidebar nav a {
    display: block;
    border-radius: 8px;
    padding: 9px 12px;
    color: var(--text-muted);
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .sidebar nav a:hover {
    background: var(--surface-alt);
    color: var(--text-color);
  }

  .sidebar nav a.is-active {
    background: var(--primary-light);
    color: color-mix(in srgb, var(--primary-color) 78%, var(--text-color));
  }

  .btn-solid {
    border-radius: 999px;
    background: var(--primary-color);
    padding: 11px;
    color: var(--primary-contrast);
    font-size: 13.5px;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    transition: background-color 180ms ease;
  }

  .btn-solid:hover {
    background: var(--primary-hover);
  }

  /* --- Feed --- */
  .feed {
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-right: 1px solid var(--border-color);
    padding: 20px 22px;
  }

  .composer {
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--border-color);
    border-radius: 14px;
    background: var(--surface-color);
    padding: 12px 16px;
  }

  .composer input {
    flex: 1;
    border: 0;
    background: none;
    color: var(--text-color);
    font-size: 13.5px;
    outline: none;
  }

  .post {
    display: flex;
    gap: 12px;
    border: 1px solid var(--border-color);
    border-radius: 14px;
    background: var(--surface-color);
    padding: 16px;
  }

  .post-body {
    min-width: 0;
    flex: 1;
  }

  .post-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0;
    color: var(--text-muted);
    font-size: 12.5px;
  }

  .post-head strong {
    color: var(--text-color);
    font-size: 13.5px;
  }

  .post-head .dot {
    width: 3px;
    height: 3px;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.5;
  }

  .post-text {
    margin: 8px 0 0;
    color: var(--text-color);
    font-size: 13.5px;
    line-height: 1.55;
  }

  .post-photo {
    aspect-ratio: 16 / 9;
    margin-top: 12px;
    border-radius: 12px;
  }

  .post-actions {
    display: flex;
    gap: 20px;
    margin-top: 14px;
  }

  .post-actions button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    font-size: 12.5px;
    font-weight: 500;
    transition: color 180ms ease;
  }

  .post-actions button:hover {
    color: var(--primary-color);
  }

  .post-actions svg {
    width: 15px;
    height: 15px;
  }

  /* --- Rail derecho --- */
  .rail {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 20px 18px;
  }

  .rail-panel {
    border: 1px solid var(--border-color);
    border-radius: 14px;
    background: var(--surface-color);
    padding: 16px;
  }

  .rail-panel h2 {
    margin: 0 0 12px;
    color: var(--text-color);
    font-size: 13.5px;
    font-weight: 600;
  }

  .rail-panel ul {
    display: grid;
    gap: 12px;
    margin: 0;
    list-style: none;
    padding: 0;
  }

  .rail-panel > ul > li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .rail-panel > ul > li a {
    color: var(--text-color);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
  }

  .rail-panel > ul > li span {
    color: var(--text-muted);
    font-size: 11.5px;
  }

  .suggestions li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .suggestions div {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
  }

  .suggestions strong {
    overflow: hidden;
    color: var(--text-color);
    font-size: 12.5px;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .suggestions span {
    color: var(--text-muted);
    font-size: 11px;
  }

  .suggestions button {
    flex: none;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    padding: 5px 11px;
    color: var(--text-color);
    font-size: 11.5px;
    font-weight: 600;
    transition: border-color 180ms ease;
  }

  .suggestions button:hover {
    border-color: var(--primary-color);
    color: var(--primary-color);
  }

  @container preview (max-width: 900px) {
    .body {
      grid-template-columns: 168px minmax(0, 1fr);
    }

    .rail {
      display: none;
    }
  }

  @container preview (max-width: 600px) {
    .body {
      grid-template-columns: 1fr;
    }

    .sidebar {
      flex-direction: row;
      align-items: center;
      border-right: 0;
      border-bottom: 1px solid var(--border-color);
      overflow-x: auto;
      padding: 12px 14px;
    }

    .sidebar nav ul {
      display: flex;
      gap: 4px;
    }

    .sidebar nav a {
      text-indent: 0;
      white-space: nowrap;
    }

    .btn-solid {
      flex: none;
      padding: 9px 16px;
    }

    .feed {
      border-right: 0;
      padding: 16px 18px;
    }
  }
</style>
