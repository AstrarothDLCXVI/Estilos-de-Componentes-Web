---
interface Props {
  eyebrow?: string;
  title?: string;
  text?: string;
}

const {
  eyebrow = 'Ahora con automatizaciones',
  title = 'El panel que tu equipo va a querer abrir cada mañana',
  text = 'Conecta tus herramientas, automatiza los informes repetitivos y deja que el equipo se concentre en decidir, no en recopilar.',
} = Astro.props;

const tabs = ['Resumen', 'Automatizaciones', 'Equipo'];
const rows = [
  { label: 'Ingresos recurrentes', value: '48.290 €', trend: '+12 %' },
  { label: 'Clientes activos', value: '1.204', trend: '+4 %' },
  { label: 'Tasa de baja', value: '1,8 %', trend: '−0,3 %' },
];
---

<section class="hero">
  <div class="glow" aria-hidden="true"></div>

  <div class="inner">
    <p class="eyebrow">
      <span class="eyebrow-dot" aria-hidden="true"></span>
      {eyebrow}
    </p>

    <h1 class="title">{title}</h1>
    <p class="text">{text}</p>

    <div class="actions">
      <a class="btn-solid" href="#">Empezar gratis</a>
      <a class="btn-outline" href="#">Hablar con ventas</a>
    </div>

    <!-- Mock de producto: ventana de navegador construida sólo con CSS. -->
    <div class="mockup" aria-hidden="true">
      <div class="mockup-bar">
        <span class="mockup-dot"></span>
        <span class="mockup-dot"></span>
        <span class="mockup-dot"></span>
        <span class="mockup-url">app.vantor.io/panel</span>
      </div>

      <div class="mockup-tabs">
        {tabs.map((tab, i) => (
          <span class={`mockup-tab ${i === 0 ? 'is-active' : ''}`}>{tab}</span>
        ))}
      </div>

      <div class="mockup-body">
        {
          rows.map((row) => (
            <div class="mockup-row">
              <span class="mockup-label">{row.label}</span>
              <span class="mockup-value">{row.value}</span>
              <span class="mockup-trend">{row.trend}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: #0a0b0f;
    padding: 72px 24px 0;
    font-family: var(--font-sans);
    text-align: center;
    isolation: isolate;
  }

  .glow {
    position: absolute;
    z-index: -1;
    top: -220px;
    left: 50%;
    width: 820px;
    height: 460px;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--primary-color) 35%, transparent), transparent 72%);
    transform: translateX(-50%);
  }

  .inner {
    max-width: 760px;
    margin-inline: auto;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.06);
    padding: 6px 14px 6px 10px;
    color: rgb(255 255 255 / 0.75);
    font-size: 12.5px;
    font-weight: 500;
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--primary-color);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary-color) 35%, transparent);
  }

  .title {
    max-width: 18ch;
    margin: 22px auto 0;
    color: #fff;
    font-size: clamp(30px, 4.8cqi + 16px, 50px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .text {
    max-width: 48ch;
    margin: 16px auto 0;
    color: rgb(255 255 255 / 0.62);
    font-size: 16px;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
  }

  .btn-solid {
    border-radius: 10px;
    background: var(--primary-color);
    padding: 12px 22px;
    color: var(--primary-contrast);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 180ms ease, transform 180ms ease;
  }

  .btn-solid:hover {
    background: var(--primary-hover);
    transform: translateY(-1px);
  }

  .btn-outline {
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 10px;
    background: rgb(255 255 255 / 0.05);
    padding: 12px 20px;
    color: #fff;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 180ms ease, background-color 180ms ease;
  }

  .btn-outline:hover {
    border-color: rgb(255 255 255 / 0.3);
    background: rgb(255 255 255 / 0.09);
  }

  .mockup {
    overflow: hidden;
    max-width: 760px;
    margin: 44px auto 0;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 16px 16px 0 0;
    background: #121319;
    box-shadow: 0 -20px 60px -20px rgb(0 0 0 / 0.6);
    text-align: left;
  }

  .mockup-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    padding: 12px 16px;
  }

  .mockup-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.16);
  }

  .mockup-url {
    margin-left: 8px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.06);
    padding: 3px 12px;
    color: rgb(255 255 255 / 0.4);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .mockup-tabs {
    display: flex;
    gap: 4px;
    padding: 10px 16px 0;
  }

  .mockup-tab {
    border-radius: 8px 8px 0 0;
    padding: 8px 14px;
    color: rgb(255 255 255 / 0.42);
    font-size: 12.5px;
    font-weight: 500;
  }

  .mockup-tab.is-active {
    background: rgb(255 255 255 / 0.05);
    color: #fff;
  }

  .mockup-body {
    display: grid;
    gap: 1px;
    background: rgb(255 255 255 / 0.06);
    padding: 1px;
  }

  .mockup-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    background: #121319;
    padding: 14px 20px;
  }

  .mockup-label {
    color: rgb(255 255 255 / 0.5);
    font-size: 12.5px;
  }

  .mockup-value {
    margin-left: auto;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .mockup-trend {
    min-width: 52px;
    color: color-mix(in srgb, var(--primary-color) 65%, #fff 20%);
    font-size: 12px;
    font-weight: 600;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  @container preview (max-width: 640px) {
    .hero {
      padding: 48px 18px 0;
    }

    .title {
      max-width: 20ch;
    }

    .mockup {
      margin-top: 34px;
      border-radius: 12px 12px 0 0;
    }

    .mockup-row {
      padding: 12px 16px;
    }
  }
</style>
