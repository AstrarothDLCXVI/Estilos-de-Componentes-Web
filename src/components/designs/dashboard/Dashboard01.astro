---
// Interior de una app (Fluxboard, la misma marca que saas-landing/):
// sidebar de navegación, topbar con búsqueda y contenido con métricas,
// gráfica y actividad reciente. Maqueta autocontenida, no usa el shell
// de la propia galería.
const navItems = [
  { label: 'Resumen', active: true },
  { label: 'Analítica', active: false },
  { label: 'Informes', active: false },
  { label: 'Equipo', active: false },
  { label: 'Ajustes', active: false },
];

const stats = [
  { label: 'Sesiones activas', value: '2.481', trend: '+8,2 %' },
  { label: 'Eventos hoy', value: '184 K', trend: '+3,1 %' },
  { label: 'Conversión', value: '3,8 %', trend: '+0,4 pp' },
  { label: 'Tiempo medio', value: '4m 12s', trend: '−0,3 %' },
];

const bars = [38, 55, 46, 70, 62, 84, 58, 72, 65, 90, 76, 68];

const activity = [
  { who: 'Nerea Salas', action: 'creó el panel', target: 'Retención semanal', time: 'hace 4 min' },
  { who: 'Iván Bermúdez', action: 'invitó a', target: 'clara@fluxboard.io', time: 'hace 22 min' },
  { who: 'Alertas', action: 'disparó una alerta en', target: 'Tasa de error API', time: 'hace 1 h' },
  { who: 'Clara Ferrer', action: 'archivó el evento', target: 'checkout_abandonado_v1', time: 'hace 3 h' },
];
---

<div class="app">
  <aside class="sidebar">
    <a class="logo" href="#">
      <span class="logo-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 17 9.5 7l5 6.5L18 9"></path>
        </svg>
      </span>
      Fluxboard
    </a>

    <nav aria-label="Principal">
      <ul role="list">
        {
          navItems.map((item) => (
            <li>
              <a class={item.active ? 'is-active' : ''} href="#">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="sidebar-user">
      <span class="avatar" aria-hidden="true">NS</span>
      <div>
        <strong>Nerea Salas</strong>
        <span>Proyecto Fluxboard</span>
      </div>
    </div>
  </aside>

  <div class="main">
    <header class="topbar">
      <label class="search">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="7" cy="7" r="4.3"></circle>
          <path d="m13 13-2.6-2.6" stroke-linecap="round"></path>
        </svg>
        <span class="visually-hidden">Buscar</span>
        <input type="search" placeholder="Buscar paneles, eventos..." />
      </label>

      <div class="topbar-actions">
        <button type="button" class="icon-btn" aria-label="Notificaciones">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path d="M4 6.6a4 4 0 0 1 8 0c0 2.9 1 3.7 1 3.7H3s1-.8 1-3.7Z" stroke-linejoin="round"></path>
            <path d="M6.6 12.3a1.5 1.5 0 0 0 2.8 0" stroke-linecap="round"></path>
          </svg>
          <span class="dot" aria-hidden="true"></span>
        </button>
        <span class="avatar" aria-hidden="true">NS</span>
      </div>
    </header>

    <main class="content">
      <div class="content-head">
        <h1>Hola, Nerea</h1>
        <p>Esto es lo que ha pasado en Fluxboard en las últimas 24 horas.</p>
      </div>

      <div class="stats">
        {
          stats.map((stat) => (
            <div class="stat">
              <span class="stat-label">{stat.label}</span>
              <strong class="stat-value">{stat.value}</strong>
              <span class="stat-trend">{stat.trend}</span>
            </div>
          ))
        }
      </div>

      <div class="panels">
        <div class="chart-panel">
          <div class="panel-head">
            <h2>Sesiones · últimos 12 días</h2>
            <span class="panel-tag">En vivo</span>
          </div>
          <div class="chart">
            {bars.map((bar) => <span style={`--h:${bar}%`} />)}
          </div>
        </div>

        <div class="activity-panel">
          <div class="panel-head">
            <h2>Actividad reciente</h2>
          </div>
          <ul role="list" class="activity-list">
            {
              activity.map((item) => (
                <li>
                  <span class="activity-dot" aria-hidden="true" />
                  <p>
                    <strong>{item.who}</strong> {item.action} <strong>{item.target}</strong>
                  </p>
                  <span class="activity-time">{item.time}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </main>
  </div>
</div>

<style>
  .app {
    display: grid;
    min-height: 620px;
    grid-template-columns: 220px minmax(0, 1fr);
    background: var(--background-color);
    font-family: var(--font-sans);
  }

  /* --- Sidebar --- */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 28px;
    border-right: 1px solid var(--border-color);
    background: var(--surface-color);
    padding: 20px 16px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 0 4px;
    color: var(--text-color);
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .logo-mark {
    display: grid;
    width: 26px;
    height: 26px;
    place-items: center;
    border-radius: 8px;
    background: var(--primary-color);
    color: var(--primary-contrast);
  }

  .logo-mark svg {
    width: 15px;
    height: 15px;
  }

  .sidebar nav ul {
    display: grid;
    gap: 2px;
    margin: 0;
    list-style: none;
    padding: 0;
  }

  .sidebar nav a {
    display: block;
    border-radius: 8px;
    padding: 8px 10px;
    color: var(--text-muted);
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .sidebar nav a:hover {
    background: var(--surface-alt);
    color: var(--text-color);
  }

  .sidebar nav a.is-active {
    background: var(--primary-light);
    color: color-mix(in srgb, var(--primary-color) 78%, var(--text-color));
  }

  .sidebar-user {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    border-top: 1px solid var(--border-color);
    padding-top: 16px;
  }

  .sidebar-user strong {
    display: block;
    color: var(--text-color);
    font-size: 12.5px;
    font-weight: 600;
  }

  .sidebar-user span {
    display: block;
    color: var(--text-muted);
    font-size: 11px;
  }

  .avatar {
    display: grid;
    width: 30px;
    height: 30px;
    flex: none;
    place-items: center;
    border-radius: 999px;
    background: var(--primary-light);
    color: color-mix(in srgb, var(--primary-color) 72%, var(--text-color));
    font-size: 10.5px;
    font-weight: 700;
  }

  /* --- Main --- */
  .main {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid var(--border-color);
    padding: 12px 24px;
  }

  .search {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    max-width: 320px;
    border: 1px solid var(--border-color);
    border-radius: 9px;
    background: var(--surface-alt);
    padding: 7px 12px;
    color: var(--text-muted);
    transition: border-color 180ms ease;
  }

  .search:focus-within {
    border-color: var(--primary-color);
  }

  .search svg {
    width: 15px;
    height: 15px;
    flex: none;
  }

  .search input {
    min-width: 0;
    flex: 1;
    border: 0;
    background: none;
    color: var(--text-color);
    font-size: 13px;
    outline: none;
  }

  .topbar-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .icon-btn {
    position: relative;
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 999px;
    color: var(--text-muted);
    transition: background-color 180ms ease, color 180ms ease;
  }

  .icon-btn:hover {
    background: var(--surface-alt);
    color: var(--text-color);
  }

  .icon-btn svg {
    width: 16px;
    height: 16px;
  }

  .icon-btn .dot {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 6px;
    height: 6px;
    border: 2px solid var(--surface-color);
    border-radius: 999px;
    background: var(--primary-color);
  }

  /* --- Contenido --- */
  .content {
    flex: 1;
    padding: 24px 28px 32px;
  }

  .content-head h1 {
    margin: 0;
    color: var(--text-color);
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .content-head p {
    margin: 5px 0 0;
    color: var(--text-muted);
    font-size: 13.5px;
  }

  .stats {
    display: grid;
    gap: 14px;
    margin-top: 22px;
    grid-template-columns: repeat(4, 1fr);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border: 1px solid var(--border-color);
    border-radius: 14px;
    background: var(--surface-color);
    padding: 16px;
  }

  .stat-label {
    color: var(--text-muted);
    font-size: 12px;
  }

  .stat-value {
    color: var(--text-color);
    font-size: 21px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .stat-trend {
    color: color-mix(in srgb, var(--primary-color) 65%, var(--text-color));
    font-size: 11.5px;
    font-weight: 600;
  }

  .panels {
    display: grid;
    gap: 16px;
    margin-top: 16px;
    grid-template-columns: 1.4fr 1fr;
  }

  .chart-panel,
  .activity-panel {
    border: 1px solid var(--border-color);
    border-radius: 14px;
    background: var(--surface-color);
    padding: 18px;
  }

  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .panel-head h2 {
    margin: 0;
    color: var(--text-color);
    font-size: 13.5px;
    font-weight: 600;
  }

  .panel-tag {
    border-radius: 999px;
    background: var(--primary-light);
    padding: 3px 9px;
    color: color-mix(in srgb, var(--primary-color) 80%, var(--text-color));
    font-size: 10.5px;
    font-weight: 600;
  }

  .chart {
    display: flex;
    height: 170px;
    align-items: flex-end;
    gap: 8px;
  }

  .chart span {
    height: var(--h);
    flex: 1;
    border-radius: 4px 4px 1px 1px;
    background: linear-gradient(to top, color-mix(in srgb, var(--primary-color) 25%, var(--surface-color)), var(--primary-color));
  }

  .activity-list {
    display: grid;
    gap: 14px;
    margin: 0;
    list-style: none;
    padding: 0;
  }

  .activity-list li {
    position: relative;
    padding-left: 16px;
  }

  .activity-dot {
    position: absolute;
    top: 5px;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--primary-color);
  }

  .activity-list p {
    margin: 0;
    color: var(--text-color);
    font-size: 12.5px;
    line-height: 1.5;
  }

  .activity-time {
    color: var(--text-muted);
    font-size: 11px;
  }

  @container preview (max-width: 820px) {
    .app {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .sidebar {
      flex-direction: row;
      align-items: center;
      gap: 16px;
      overflow-x: auto;
    }

    .sidebar nav ul {
      display: flex;
      gap: 4px;
    }

    .sidebar-user {
      margin: 0 0 0 auto;
      border-top: 0;
      padding-top: 0;
    }

    .panels {
      grid-template-columns: 1fr;
    }
  }

  @container preview (max-width: 640px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .content {
      padding: 20px 18px 26px;
    }

    .topbar {
      padding: 12px 18px;
    }
  }
</style>
