---
// Hoja de especificación: la misma acción en todas sus jerarquías, tamaños y
// estados. Es la vista que se consulta al implementar, no un escaparate.
---

<div class="sheet">
  <section class="row">
    <p class="row-label">Jerarquía</p>
    <div class="row-items">
      <button type="button" class="btn btn-solid">Guardar cambios</button>
      <button type="button" class="btn btn-tonal">Guardar cambios</button>
      <button type="button" class="btn btn-outline">Guardar cambios</button>
      <button type="button" class="btn btn-ghost">Guardar cambios</button>
    </div>
  </section>

  <section class="row">
    <p class="row-label">Tamaños</p>
    <div class="row-items">
      <button type="button" class="btn btn-solid size-sm">Pequeño</button>
      <button type="button" class="btn btn-solid">Mediano</button>
      <button type="button" class="btn btn-solid size-lg">Grande</button>
    </div>
  </section>

  <section class="row">
    <p class="row-label">Con icono</p>
    <div class="row-items">
      <button type="button" class="btn btn-solid">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M8 3.5v9M3.5 8h9" stroke-linecap="round"></path>
        </svg>
        Añadir registro
      </button>
      <button type="button" class="btn btn-outline">
        Exportar
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M8 3v8M4.5 7.5 8 11l3.5-3.5M3 13h10" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
      <button type="button" class="btn btn-outline btn-icon" aria-label="Más opciones">
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <circle cx="3.5" cy="8" r="1.3"></circle>
          <circle cx="8" cy="8" r="1.3"></circle>
          <circle cx="12.5" cy="8" r="1.3"></circle>
        </svg>
      </button>
    </div>
  </section>

  <section class="row">
    <p class="row-label">Estados</p>
    <div class="row-items">
      <button type="button" class="btn btn-solid is-loading">
        <span class="spinner" aria-hidden="true"></span>
        Guardando
      </button>
      <button type="button" class="btn btn-solid" disabled>No disponible</button>
      <button type="button" class="btn btn-outline" disabled>No disponible</button>
    </div>
  </section>
</div>

<style>
  .sheet {
    display: grid;
    gap: 2px;
    overflow: hidden;
    border: 1px solid var(--border-color);
    border-radius: 16px;
    background: var(--border-color);
    font-family: var(--font-sans);
  }

  .row {
    display: grid;
    align-items: center;
    gap: 18px;
    grid-template-columns: 120px 1fr;
    background: var(--surface-color);
    padding: 18px 20px;
  }

  .row-label {
    margin: 0;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .row-items {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 10px 16px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease,
      transform 160ms ease;
  }

  .btn svg {
    width: 15px;
    height: 15px;
  }

  .btn:active:not(:disabled) {
    transform: translateY(1px);
  }

  .btn:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .btn-solid {
    background: var(--primary-color);
    color: var(--primary-contrast);
  }

  .btn-solid:hover:not(:disabled) {
    background: var(--primary-hover);
  }

  .btn-tonal {
    background: var(--primary-light);
    color: color-mix(in srgb, var(--primary-color) 78%, var(--text-color));
  }

  .btn-tonal:hover:not(:disabled) {
    background: color-mix(in srgb, var(--primary-color) 22%, var(--surface-color));
  }

  .btn-outline {
    border-color: var(--border-color);
    background: var(--surface-color);
    color: var(--text-color);
  }

  .btn-outline:hover:not(:disabled) {
    border-color: var(--primary-color);
    color: var(--primary-color);
  }

  .btn-ghost {
    background: transparent;
    color: var(--text-muted);
  }

  .btn-ghost:hover:not(:disabled) {
    background: var(--surface-alt);
    color: var(--text-color);
  }

  .size-sm {
    border-radius: 7px;
    padding: 7px 12px;
    font-size: 13px;
  }

  .size-lg {
    border-radius: 11px;
    padding: 14px 24px;
    font-size: 15.5px;
  }

  .btn-icon {
    padding: 10px;
  }

  .spinner {
    width: 14px;
    height: 14px;
    border: 2px solid color-mix(in srgb, var(--primary-contrast) 35%, transparent);
    border-top-color: var(--primary-contrast);
    border-radius: 999px;
    animation: spin 700ms linear infinite;
  }

  .is-loading {
    cursor: progress;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @container preview (max-width: 640px) {
    .row {
      gap: 12px;
      grid-template-columns: 1fr;
    }
  }
</style>
