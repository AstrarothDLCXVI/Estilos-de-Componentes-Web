---
// Cuatro micro-interacciones distintas sobre el mismo color: relleno que
// barre, borde degradado, relieve con sombra sólida y flecha que se desplaza.
const items = [
  { name: 'Barrido', hint: 'El relleno entra desde la izquierda' },
  { name: 'Borde degradado', hint: 'Superficie limpia, contorno teñido' },
  { name: 'Relieve', hint: 'Sombra sólida que se hunde al pulsar' },
  { name: 'Flecha', hint: 'La flecha sale del propio botón' },
];
---

<div class="grid">
  <figure class="cell">
    <button type="button" class="sweep">
      <span>Reservar una demo</span>
    </button>
    <figcaption>
      <strong>{items[0].name}</strong>
      {items[0].hint}
    </figcaption>
  </figure>

  <figure class="cell">
    <button type="button" class="gradient">
      <span>Ver el plan Pro</span>
    </button>
    <figcaption>
      <strong>{items[1].name}</strong>
      {items[1].hint}
    </figcaption>
  </figure>

  <figure class="cell">
    <button type="button" class="raised">Empezar ahora</button>
    <figcaption>
      <strong>{items[2].name}</strong>
      {items[2].hint}
    </figcaption>
  </figure>

  <figure class="cell">
    <button type="button" class="arrow">
      Continuar
      <span class="arrow-slot" aria-hidden="true">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 8h9M8.5 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
    </button>
    <figcaption>
      <strong>{items[3].name}</strong>
      {items[3].hint}
    </figcaption>
  </figure>
</div>

<style>
  .grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    font-family: var(--font-sans);
  }

  .cell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    margin: 0;
    border: 1px solid var(--border-color);
    border-radius: 16px;
    background: var(--surface-color);
    padding: 22px 20px 18px;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--text-muted);
    font-size: 12px;
    line-height: 1.5;
  }

  figcaption strong {
    color: var(--text-color);
    font-size: 12.5px;
    font-weight: 600;
  }

  button {
    border: 0;
    font-family: inherit;
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
  }

  /* 1 · Barrido */
  .sweep {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--primary-color);
    border-radius: 999px;
    background: transparent;
    padding: 12px 22px;
    color: var(--primary-color);
    isolation: isolate;
    transition: color 220ms ease;
  }

  .sweep::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--primary-color);
    content: '';
    transform: translateX(-101%);
    transition: transform 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .sweep:hover {
    color: var(--primary-contrast);
  }

  .sweep:hover::before {
    transform: translateX(0);
  }

  /* 2 · Borde degradado (padding-box + border-box) */
  .gradient {
    border: 1.5px solid transparent;
    border-radius: 12px;
    padding: 12px 22px;
    color: var(--text-color);
    background:
      linear-gradient(var(--surface-color), var(--surface-color)) padding-box,
      linear-gradient(
          120deg,
          var(--primary-color),
          color-mix(in srgb, var(--primary-color) 30%, var(--text-color))
        )
        border-box;
    transition: box-shadow 200ms ease, transform 200ms ease;
  }

  .gradient:hover {
    box-shadow: 0 0 0 4px var(--primary-soft);
    transform: translateY(-1px);
  }

  /* 3 · Relieve */
  .raised {
    border-radius: 12px;
    background: var(--primary-color);
    padding: 12px 22px;
    color: var(--primary-contrast);
    box-shadow: 0 4px 0 0 color-mix(in srgb, var(--primary-color) 55%, #000);
    transition: transform 120ms ease, box-shadow 120ms ease;
  }

  .raised:hover {
    transform: translateY(-1px);
    box-shadow: 0 5px 0 0 color-mix(in srgb, var(--primary-color) 55%, #000);
  }

  .raised:active {
    transform: translateY(4px);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--primary-color) 55%, #000);
  }

  /* 4 · Flecha */
  .arrow {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border-radius: 999px;
    background: var(--primary-color);
    padding: 8px 8px 8px 20px;
    color: var(--primary-contrast);
  }

  .arrow-slot {
    display: grid;
    overflow: hidden;
    width: 32px;
    height: 32px;
    place-items: center;
    border-radius: 999px;
    background: color-mix(in srgb, var(--primary-contrast) 22%, transparent);
  }

  .arrow-slot svg {
    width: 15px;
    height: 15px;
    transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .arrow:hover .arrow-slot svg {
    animation: slide 480ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @keyframes slide {
    50% {
      transform: translateX(140%);
    }

    51% {
      transform: translateX(-140%);
    }
  }
</style>
