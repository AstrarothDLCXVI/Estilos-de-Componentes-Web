---
import { navItems } from '@/data/sample';

interface Props {
  brand?: string;
  items?: typeof navItems;
}

const { brand = 'Meridian', items = navItems } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="bar">
    <a class="logo" href="#">{brand}</a>

    <nav aria-label="Enlaces del sitio">
      <ul role="list" class="nav-list">
        {
          items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <form class="newsletter" onsubmit="return false">
      <label class="visually-hidden" for="footer02-email">Correo electrónico</label>
      <input id="footer02-email" type="email" placeholder="tu@empresa.com" autocomplete="email" />
      <button type="submit" aria-label="Suscribirse">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 8h9M8.5 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </form>
  </div>

  <div class="bottom">
    <p>© {year} {brand}</p>
    <div class="social">
      <a href="#" aria-label="X (Twitter)">
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M9.53 6.9 13.7 2h-1.3L8.94 6.06 6.13 2H2.3l4.37 6.24L2.3 13.4h1.3l3.66-4.3 3 4.3h3.83L9.53 6.9Z" />
        </svg>
      </a>
      <a href="#" aria-label="GitHub">
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 1.6a6.9 6.9 0 0 0-2.18 13.44c.35.06.47-.15.47-.33v-1.3c-1.92.42-2.33-.82-2.33-.82-.31-.8-.77-1.02-.77-1.02-.63-.43.05-.42.05-.42.7.05 1.06.71 1.06.71.62 1.06 1.62.76 2.02.58.06-.45.24-.76.44-.93-1.53-.17-3.14-.77-3.14-3.4 0-.75.27-1.36.7-1.85-.07-.17-.3-.87.07-1.81 0 0 .58-.19 1.9.7a6.6 6.6 0 0 1 3.46 0c1.32-.89 1.9-.7 1.9-.7.37.94.14 1.64.07 1.81.44.49.7 1.1.7 1.85 0 2.64-1.62 3.22-3.15 3.4.25.21.47.63.47 1.27v1.88c0 .18.12.4.48.33A6.9 6.9 0 0 0 8 1.6Z" />
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-color);
    background: var(--surface-color);
    font-family: var(--font-sans);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    max-width: 1180px;
    margin-inline: auto;
    padding: 22px 28px;
  }

  .logo {
    color: var(--text-color);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin: 0;
    list-style: none;
    padding: 0;
  }

  .nav-list a {
    color: var(--text-muted);
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .nav-list a:hover {
    color: var(--text-color);
  }

  .newsletter {
    display: flex;
    margin-left: auto;
    gap: 6px;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--surface-alt);
    padding: 4px 4px 4px 14px;
    transition: border-color 180ms ease;
  }

  .newsletter:focus-within {
    border-color: var(--primary-color);
  }

  .newsletter input {
    min-width: 0;
    width: 170px;
    border: 0;
    background: none;
    color: var(--text-color);
    font-size: 13px;
    outline: none;
  }

  .newsletter input::placeholder {
    color: var(--text-muted);
  }

  .newsletter button {
    display: grid;
    width: 28px;
    height: 28px;
    flex: none;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: var(--primary-color);
    color: var(--primary-contrast);
    cursor: pointer;
    transition: background-color 180ms ease;
  }

  .newsletter button:hover {
    background: var(--primary-hover);
  }

  .newsletter svg {
    width: 13px;
    height: 13px;
  }

  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    max-width: 1180px;
    margin-inline: auto;
    border-top: 1px solid var(--border-color);
    padding: 14px 28px;
  }

  .bottom p {
    margin: 0;
    color: var(--text-muted);
    font-size: 12px;
  }

  .social {
    display: flex;
    gap: 14px;
  }

  .social a {
    color: var(--text-muted);
    transition: color 180ms ease;
  }

  .social a:hover {
    color: var(--text-color);
  }

  .social svg {
    width: 14px;
    height: 14px;
  }

  @container preview (max-width: 640px) {
    .bar {
      padding: 18px 20px;
    }

    .nav-list {
      order: 3;
      width: 100%;
      gap: 14px;
    }

    .newsletter {
      margin-left: 0;
    }

    .newsletter input {
      width: 140px;
    }
  }
</style>
