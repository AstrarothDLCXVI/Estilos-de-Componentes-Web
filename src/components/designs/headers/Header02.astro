---
import { navItems } from '@/data/sample';

interface Props {
  brand?: string;
  items?: typeof navItems;
  cta?: string;
}

const { brand = 'Nordika', items = navItems, cta = 'Solicitar demo' } = Astro.props;
---

<div class="band">
  <header class="floating">
    <a class="logo" href="#">
      <span class="logo-mark" aria-hidden="true"></span>
      <span class="logo-word">{brand}</span>
    </a>

    <nav class="nav" aria-label="Principal">
      <ul role="list" class="pills">
        {
          items.map((item) => (
            <li>
              <a class="pill" href={item.href} aria-current={item.current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <a class="login" href="#">Iniciar sesión</a>
      <a class="cta" href="#">
        {cta}
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
          <path d="M3 8h9M8.5 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <!-- Menú móvil con <details>: funciona sin una sola línea de JS. -->
    <details class="menu">
      <summary aria-label="Abrir menú">
        <span class="burger" aria-hidden="true"></span>
      </summary>
      <div class="menu-panel">
        <ul role="list" class="menu-list">
          {
            items.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
          <li>
            <a href="#">Iniciar sesión</a>
          </li>
        </ul>
        <a class="cta cta-block" href="#">{cta}</a>
      </div>
    </details>
  </header>
</div>

<style>
  .band {
    background:
      radial-gradient(120% 140% at 15% -30%, var(--primary-light), transparent 60%),
      var(--background-color);
    padding: 22px 20px 30px;
    font-family: var(--font-sans);
  }

  .floating {
    position: relative;
    display: flex;
    max-width: 1080px;
    align-items: center;
    gap: 18px;
    margin-inline: auto;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--surface-color);
    padding: 8px 8px 8px 20px;
    box-shadow: var(--shadow-lg);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text-color);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .logo-mark {
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: conic-gradient(
      from 210deg,
      var(--primary-color),
      color-mix(in srgb, var(--primary-color) 35%, #fff) 55%,
      var(--primary-color)
    );
    box-shadow: 0 0 0 4px var(--primary-soft);
    transition: box-shadow 180ms ease;
  }

  .pills {
    display: flex;
    gap: 2px;
    margin: 0;
    list-style: none;
    padding: 0;
  }

  .pill {
    display: block;
    border-radius: 999px;
    padding: 8px 14px;
    color: var(--text-muted);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .pill:hover {
    background: var(--surface-alt);
    color: var(--text-color);
  }

  .pill[aria-current='page'] {
    background: var(--primary-light);
    color: color-mix(in srgb, var(--primary-color) 78%, var(--text-color));
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }

  .login {
    padding: 8px 12px;
    color: var(--text-muted);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .login:hover {
    color: var(--text-color);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border-radius: 999px;
    background: var(--primary-color);
    padding: 10px 16px;
    color: var(--primary-contrast);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 180ms ease;
  }

  .cta svg {
    width: 15px;
    height: 15px;
    transition: transform 200ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .cta:hover {
    background: var(--primary-hover);
  }

  .cta:hover svg {
    transform: translateX(3px);
  }

  .menu {
    display: none;
    margin-left: auto;
  }

  .menu summary {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: 999px;
    background: var(--surface-alt);
    cursor: pointer;
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 16px;
    height: 1.8px;
    border-radius: 2px;
    background: var(--text-color);
    content: '';
    transition: transform 200ms ease;
  }

  .burger::before {
    transform: translateY(-5.5px);
  }

  .burger::after {
    transform: translateY(3.7px);
  }

  .menu[open] .burger {
    background: transparent;
  }

  .menu[open] .burger::before {
    transform: rotate(45deg);
  }

  .menu[open] .burger::after {
    transform: translateY(-1.8px) rotate(-45deg);
  }

  .menu-panel {
    position: absolute;
    z-index: 5;
    top: calc(100% + 10px);
    right: 0;
    left: 0;
    border: 1px solid var(--border-color);
    border-radius: 20px;
    background: var(--surface-color);
    padding: 12px;
    box-shadow: var(--shadow-lg);
  }

  .menu-list {
    margin: 0 0 10px;
    list-style: none;
    padding: 0;
  }

  .menu-list a {
    display: block;
    border-radius: 12px;
    padding: 10px 12px;
    color: var(--text-color);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }

  .menu-list a:hover {
    background: var(--surface-alt);
  }

  .cta-block {
    justify-content: center;
    width: 100%;
  }

  @container preview (max-width: 820px) {
    .nav,
    .actions {
      display: none;
    }

    .menu {
      display: block;
    }

    .floating {
      padding: 8px 8px 8px 18px;
    }
  }
</style>
