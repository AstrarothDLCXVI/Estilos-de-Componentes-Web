---
// Web de cuidado a domicilio para personas mayores y dependientes. Mismo
// mecanismo de hero que el resto de páginas con foto real: la imagen se
// disuelve en el fondo mediante una máscara de degradado, en clave cálida
// y tranquilizadora (nada de azul clínico).
const badges = [
  { value: '+12 años', label: 'de experiencia' },
  { value: '100%', label: 'personal certificado' },
  { value: '24/7', label: 'disponibilidad' },
  { value: 'Con seguro', label: 'de responsabilidad civil' },
];

const services = [
  {
    img: '/images/CuidadoPersonas/fotos/foto3.png',
    alt: 'Cuidadora ayudando a una mujer mayor a ponerse una rebeca en su habitación',
    title: 'Cuidado personal',
    text: 'Ayuda con el aseo, vestirse y la movilidad diaria, siempre respetando su ritmo y su intimidad.',
  },
  {
    img: '/images/CuidadoPersonas/fotos/foto1.png',
    alt: 'Cuidadora y hombre mayor tomando un café y conversando en el salón',
    title: 'Compañía y conversación',
    text: 'Alguien con quien compartir un café, salir a pasear o simplemente charlar por la tarde.',
  },
  {
    img: '/images/CuidadoPersonas/fotos/foto4.png',
    alt: 'Cuidadora revisando un organizador de medicación junto a una mujer mayor',
    title: 'Gestión de medicación',
    text: 'Control de horarios y dosis, con coordinación directa con médicos y farmacia.',
  },
  {
    img: '/images/CuidadoPersonas/hearder/hearder2.png',
    alt: 'Cuidadora sosteniendo la mano de una mujer mayor con cariño',
    title: 'Acompañamiento emocional',
    text: 'Presencia cercana en los momentos que más lo necesita: no sólo tareas, también compañía de verdad.',
  },
];

const steps = [
  { n: '01', title: 'Valoración gratuita', text: 'Visitamos su domicilio sin compromiso para entender qué necesita.' },
  { n: '02', title: 'Plan a medida', text: 'Diseñamos un plan de cuidados ajustado a su rutina y a su familia.' },
  { n: '03', title: 'Cuidador/a compatible', text: 'Asignamos un profesional afín, no el primero que esté disponible.' },
  { n: '04', title: 'Seguimiento continuo', text: 'Revisamos el plan cada mes y ajustamos lo que haga falta.' },
];
---

<div class="site">
  <header class="topbar">
    <a class="brand" href="#">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 20.5S4 15.8 4 9.9A4.4 4.4 0 0 1 12 7a4.4 4.4 0 0 1 8 2.9c0 5.9-8 10.6-8 10.6Z"></path>
        </svg>
      </span>
      Cuidalia
    </a>

    <nav aria-label="Principal">
      <ul role="list">
        <li><a href="#servicios">Servicios</a></li>
        <li><a href="#como-funciona">Cómo funciona</a></li>
        <li><a href="#nosotros">Nosotros</a></li>
      </ul>
    </nav>

    <a class="header-cta" href="#contacto">Pedir información</a>
  </header>

  <section class="hero">
    <div class="hero-media">
      <img
        class="hero-photo"
        src="/images/CuidadoPersonas/hearder/hearder1.png"
        alt="Cuidadora sonriente acompañando a un hombre mayor junto a una ventana con jardín"
        fetchpriority="high"
      />
    </div>

    <div class="hero-content">
      <p class="hero-kicker">Cuidado profesional a domicilio</p>
      <h1 class="hero-title">Que cada día en casa sea un poco más fácil</h1>
      <p class="hero-line">
        Auxiliares certificados que acompañan a su familiar con la misma dedicación que le daría
        usted. Valoración gratuita en menos de 48 horas.
      </p>
      <div class="hero-actions">
        <a class="btn-solid" href="#contacto">Pedir valoración gratuita</a>
        <a class="btn-outline" href="#como-funciona">Cómo funciona</a>
      </div>
    </div>
  </section>

  <section class="badges">
    {
      badges.map((badge) => (
        <div class="badge">
          <strong>{badge.value}</strong>
          <span>{badge.label}</span>
        </div>
      ))
    }
  </section>

  <section class="services" id="servicios">
    <header class="section-head">
      <p class="kicker">Servicios</p>
      <h2>Cuidado adaptado a cada persona, no un paquete cerrado</h2>
    </header>

    <div class="services-grid">
      {
        services.map((service) => (
          <article class="service">
            <div class="service-photo">
              <img src={service.img} alt={service.alt} loading="lazy" decoding="async" />
            </div>
            <div class="service-body">
              <h3>{service.title}</h3>
              <p>{service.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="process" id="como-funciona">
    <header class="section-head">
      <p class="kicker">Cómo funciona</p>
      <h2>Cuatro pasos, sin prisa y sin letra pequeña</h2>
    </header>

    <ol class="process-list">
      {
        steps.map((step) => (
          <li class="process-step">
            <span class="process-n">{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="about" id="nosotros">
    <div class="about-photo">
      <img
        src="/images/CuidadoPersonas/fotos/foto2.png"
        alt="Mujer mayor y cuidadora riendo juntas junto a una ventana"
        loading="lazy"
      />
    </div>
    <div class="about-copy">
      <p class="kicker">Nosotros</p>
      <h2>Cuidamos como nos gustaría que cuidaran a los nuestros</h2>
      <p>
        Cuidalia nació de una necesidad familiar, no de un plan de negocio. Seleccionamos a cada
        auxiliar con la misma exigencia con la que elegiríamos a alguien para cuidar de nuestra
        propia madre: formación verificada, referencias comprobadas y una entrevista personal
        antes de asignarles ninguna familia.
      </p>
    </div>
  </section>

  <section class="cta-band" id="contacto">
    <h2>Hablemos de qué necesita su familia</h2>
    <p>Sin compromiso, sin permanencia mínima. Respondemos el mismo día.</p>
    <div class="cta-actions">
      <a class="btn-solid" href="tel:+34900123456">Llamar ahora · 900 123 456</a>
      <a class="btn-outline" href="mailto:hola@cuidalia.es">hola@cuidalia.es</a>
    </div>
  </section>

  <footer class="footer">
    <div class="footer-top">
      <div>
        <a class="brand" href="#">Cuidalia</a>
        <p>Cuidado a domicilio para personas mayores y dependientes.</p>
      </div>

      <div class="footer-col">
        <p class="footer-title">Zona de servicio</p>
        <p>Madrid capital y área metropolitana</p>
      </div>

      <div class="footer-col">
        <p class="footer-title">Horario de atención</p>
        <p>Lunes a domingo, 24 horas</p>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© 2026 Cuidalia</span>
      <ul role="list">
        <li><a href="#">Privacidad</a></li>
        <li><a href="#">Aviso legal</a></li>
        <li><a href="#">Trabaja con nosotros</a></li>
      </ul>
    </div>
  </footer>
</div>

<style>
  .site {
    position: relative;
    background: #fbf7f0;
    color: #2c261e;
    font-family: var(--font-sans);
  }

  /* --- Topbar: flota sobre el hero, anclada al mismo contenedor --- */
  .topbar {
    position: absolute;
    z-index: 3;
    top: 0;
    right: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 32px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: #fff;
    font-family: 'IBM Plex Serif', ui-serif, Georgia, serif;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.18);
    color: #fff;
  }

  .brand-mark svg {
    width: 15px;
    height: 15px;
  }

  .topbar nav ul {
    display: flex;
    gap: 26px;
    margin: 0;
    list-style: none;
    padding: 0;
  }

  .topbar nav a {
    color: rgb(255 255 255 / 0.85);
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .topbar nav a:hover {
    color: #fff;
  }

  .header-cta {
    border-radius: 999px;
    background: #fff;
    padding: 10px 18px;
    color: #2c261e;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 180ms ease;
  }

  .header-cta:hover {
    transform: translateY(-1px);
  }

  /* --- Hero: la foto se disuelve en el fondo cálido --- */
  .hero {
    position: relative;
    height: 660px;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
  }

  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    mask-image: linear-gradient(to bottom, #000 0%, #000 44%, transparent 92%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 44%, transparent 92%);
  }

  @supports (animation-timeline: scroll()) {
    .hero-photo {
      animation: hero-scroll-fade linear forwards;
      animation-timeline: scroll(root block);
      animation-range: 0 65vh;
    }

    @keyframes hero-scroll-fade {
      to {
        opacity: 0.3;
        transform: scale(1.08);
      }
    }
  }

  .hero::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(180deg, rgb(30 20 6 / 0.42) 0%, rgb(30 20 6 / 0.04) 30%, rgb(251 247 240 / 0.1) 58%, #fbf7f0 100%);
    content: '';
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 24px;
    text-align: center;
  }

  .hero-kicker {
    margin: 0;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hero-title {
    max-width: 17ch;
    margin: 18px 0 0;
    color: #fff;
    font-family: 'IBM Plex Serif', ui-serif, Georgia, serif;
    font-size: clamp(30px, 4.6cqi + 16px, 52px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .hero-line {
    max-width: 46ch;
    margin: 18px 0 0;
    color: rgb(255 255 255 / 0.88);
    font-size: 15px;
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
  }

  .btn-solid {
    border-radius: 999px;
    background: var(--primary-color);
    padding: 12px 22px;
    color: var(--primary-contrast);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 180ms ease, transform 180ms ease;
  }

  .btn-solid:hover {
    background: var(--primary-hover);
    transform: translateY(-1px);
  }

  .btn-outline {
    display: inline-block;
    border: 1px solid rgb(255 255 255 / 0.55);
    border-radius: 999px;
    padding: 12px 20px;
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 200ms ease;
  }

  .hero-actions .btn-outline:hover {
    background: rgb(255 255 255 / 0.14);
  }

  /* --- Franja de confianza --- */
  .badges {
    display: grid;
    gap: 1px;
    background: #ece4d5;
    grid-template-columns: repeat(4, 1fr);
  }

  .badge {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: #fbf7f0;
    padding: 22px 20px;
    text-align: center;
  }

  .badge strong {
    font-family: 'IBM Plex Serif', ui-serif, Georgia, serif;
    font-size: 19px;
    font-weight: 600;
    color: var(--primary-color);
  }

  .badge span {
    color: #6e6455;
    font-size: 12px;
  }

  /* --- Genéricos --- */
  .kicker {
    margin: 0;
    color: var(--primary-color);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .section-head {
    max-width: 620px;
    margin: 0 auto 36px;
    padding: 0 24px;
    text-align: center;
  }

  .section-head h2 {
    margin: 10px 0 0;
    font-family: 'IBM Plex Serif', ui-serif, Georgia, serif;
    font-size: clamp(23px, 2.6cqi + 14px, 30px);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  /* --- Servicios --- */
  .services {
    max-width: 1140px;
    margin: 0 auto;
    padding: 76px 24px;
  }

  .services-grid {
    display: grid;
    gap: 22px;
    grid-template-columns: repeat(2, 1fr);
  }

  .service {
    display: flex;
    overflow: hidden;
    border: 1px solid #ece4d5;
    border-radius: 16px;
    background: #fff;
  }

  .service-photo {
    flex: none;
    width: 42%;
    overflow: hidden;
  }

  .service-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service-body {
    padding: 20px 22px;
  }

  .service-body h3 {
    margin: 0;
    font-family: 'IBM Plex Serif', ui-serif, Georgia, serif;
    font-size: 16.5px;
    font-weight: 600;
  }

  .service-body p {
    margin: 8px 0 0;
    color: #6e6455;
    font-size: 13px;
    line-height: 1.6;
  }

  /* --- Cómo funciona --- */
  .process {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px 84px;
  }

  .process-list {
    display: grid;
    gap: 22px;
    margin: 0;
    list-style: none;
    padding: 0;
    grid-template-columns: repeat(4, 1fr);
  }

  .process-step {
    border-top: 2px solid var(--primary-color);
    padding-top: 16px;
  }

  .process-n {
    color: #a89a80;
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .process-step h3 {
    margin: 8px 0 0;
    font-family: 'IBM Plex Serif', ui-serif, Georgia, serif;
    font-size: 15.5px;
    font-weight: 600;
  }

  .process-step p {
    margin: 8px 0 0;
    color: #6e6455;
    font-size: 13px;
    line-height: 1.6;
  }

  /* --- Sobre nosotros --- */
  .about {
    display: grid;
    max-width: 1080px;
    gap: 44px;
    margin: 0 auto;
    padding: 0 24px 90px;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: center;
  }

  .about-photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 18px;
    object-fit: cover;
    box-shadow: 0 26px 50px -26px rgb(60 40 10 / 0.35);
  }

  .about-copy h2 {
    margin: 10px 0 0;
    font-family: 'IBM Plex Serif', ui-serif, Georgia, serif;
    font-size: clamp(22px, 2.6cqi + 14px, 30px);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .about-copy p {
    max-width: 46ch;
    margin: 16px 0 0;
    color: #6e6455;
    font-size: 14.5px;
    line-height: 1.75;
  }

  /* --- CTA --- */
  .cta-band {
    margin: 0 24px 84px;
    border-radius: 24px;
    background: #2c261e;
    padding: 60px 32px;
    color: #fbf7f0;
    text-align: center;
  }

  .cta-band h2 {
    margin: 0;
    font-family: 'IBM Plex Serif', ui-serif, Georgia, serif;
    font-size: clamp(24px, 2.8cqi + 14px, 32px);
    font-weight: 600;
  }

  .cta-band p {
    max-width: 44ch;
    margin: 12px auto 0;
    color: rgb(251 247 240 / 0.7);
    font-size: 14px;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 26px;
  }

  .cta-band .btn-outline {
    border-color: rgb(251 247 240 / 0.35);
  }

  /* --- Footer --- */
  .footer {
    border-top: 1px solid #ece4d5;
    padding: 48px 32px 24px;
  }

  .footer-top {
    display: grid;
    max-width: 1140px;
    gap: 32px;
    margin: 0 auto;
    grid-template-columns: 1.4fr 1fr 1fr;
  }

  .footer-top p {
    margin: 10px 0 0;
    max-width: 32ch;
    color: #6e6455;
    font-size: 13px;
    line-height: 1.6;
  }

  .footer-title {
    margin: 0;
    color: #2c261e;
    font-size: 12.5px;
    font-weight: 700;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    max-width: 1140px;
    margin: 32px auto 0;
    padding-top: 20px;
    border-top: 1px solid #ece4d5;
    color: #a89a80;
    font-size: 12px;
  }

  .footer-bottom ul {
    display: flex;
    gap: 16px;
    margin: 0;
    list-style: none;
    padding: 0;
  }

  .footer-bottom a {
    color: #a89a80;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .footer-bottom a:hover {
    color: #2c261e;
  }

  @container preview (max-width: 860px) {
    .services-grid,
    .process-list {
      grid-template-columns: 1fr 1fr;
    }

    .about {
      grid-template-columns: 1fr;
    }

    .about-photo img {
      max-width: 340px;
    }

    .footer-top {
      grid-template-columns: 1fr;
    }
  }

  @container preview (max-width: 600px) {
    .topbar {
      flex-wrap: wrap;
      gap: 12px;
      padding: 16px 20px;
    }

    .hero {
      height: 600px;
    }

    .badges {
      grid-template-columns: repeat(2, 1fr);
    }

    .services-grid,
    .process-list {
      grid-template-columns: 1fr;
    }

    .service {
      flex-direction: column;
    }

    .service-photo {
      width: 100%;
      aspect-ratio: 16 / 10;
    }

    .cta-band {
      margin-inline: 16px;
      padding: 44px 22px;
    }
  }
</style>
