---
// Tienda de ropa streetwear con fotografía real. Mismo mecanismo de hero que
// personal-portfolio/, restaurant/ y saas-landing/: la foto se disuelve en
// el fondo mediante una máscara de degradado. El header enlaza a cinco
// secciones reales de catálogo (anclas), así que "acceder a varios
// apartados" funciona incluso sin JavaScript ni CSS avanzado.
interface Product {
  src: string;
  name: string;
  price: string;
}

interface Category {
  id: string;
  label: string;
  text: string;
  products: Product[];
}

const categories: Category[] = [
  {
    id: 'camisetas',
    label: 'Camisetas',
    text: 'Algodón grueso, cortes oversize y estampados que no se lavan al segundo uso.',
    products: [
      { src: '/images/tiendaRopa/prendas/prenda2.png', name: 'Camiseta oversize negra', price: '24,90 €' },
      { src: '/images/tiendaRopa/prendas/prenda3.png', name: 'Camiseta gráfica NYC', price: '27,90 €' },
      { src: '/images/tiendaRopa/prendas/prenda6.png', name: 'Camiseta gráfica ciudad', price: '26,90 €' },
      { src: '/images/tiendaRopa/prendas/prenda7.png', name: 'Camiseta oversize básica', price: '22,90 €' },
      { src: '/images/tiendaRopa/prendas/prenda1.png', name: 'Camiseta washed gris', price: '23,90 €' },
    ],
  },
  {
    id: 'sudaderas',
    label: 'Sudaderas',
    text: 'Capucha forrada y bolsillo canguro. Las que no te quitas en todo el invierno.',
    products: [
      { src: '/images/tiendaRopa/prendas/prenda4.png', name: 'Sudadera capucha gris', price: '39,90 €' },
      { src: '/images/tiendaRopa/prendas/prenda5.png', name: 'Sudadera capucha negra', price: '42,90 €' },
    ],
  },
  {
    id: 'pantalones',
    label: 'Pantalones',
    text: 'De cargo a vaquero wide leg: volumen controlado, nunca disfraz.',
    products: [
      { src: '/images/tiendaRopa/prendas/pantalon1.png', name: 'Pantalón cargo negro', price: '44,90 €' },
      { src: '/images/tiendaRopa/prendas/patalon2.png', name: 'Vaquero ancho oscuro', price: '49,90 €' },
      { src: '/images/tiendaRopa/prendas/pantalon3.png', name: 'Vaquero wide leg', price: '47,90 €' },
      { src: '/images/tiendaRopa/prendas/pantalon4.png', name: 'Pantalón técnico negro', price: '54,90 €' },
      { src: '/images/tiendaRopa/prendas/pantalon5.png', name: 'Vaquero carpenter', price: '52,90 €' },
    ],
  },
  {
    id: 'calzado',
    label: 'Calzado',
    text: 'De la zapatilla blanca que combina con todo a la que llama la atención sola.',
    products: [
      { src: '/images/tiendaRopa/prendas/calzado1.png', name: 'Zapatilla urbana gris', price: '79,90 €' },
      { src: '/images/tiendaRopa/prendas/calzado2.png', name: 'Zapatilla blanca clásica', price: '64,90 €' },
      { src: '/images/tiendaRopa/prendas/calzado3.png', name: 'Zapatilla negra street', price: '69,90 €' },
    ],
  },
  {
    id: 'accesorios',
    label: 'Accesorios',
    text: 'El remate del look, la parte que la gente pregunta de dónde es.',
    products: [
      { src: '/images/tiendaRopa/prendas/gorro.png', name: 'Gorro beanie District', price: '16,90 €' },
      { src: '/images/tiendaRopa/prendas/gorro2.png', name: 'Gorra clásica negra', price: '19,90 €' },
    ],
  },
];

const perks = [
  { title: 'Envío gratis desde 60 €', text: 'Entrega en 24-48 h en península.' },
  { title: 'Devolución en 30 días', text: 'Sin preguntas, sin letra pequeña.' },
  { title: 'Pago seguro', text: 'Tarjeta, PayPal o financiación en 3 plazos.' },
];
---

<div class="site">
  <header class="topbar">
    <a class="brand" href="#">CONCRETO</a>

    <nav aria-label="Principal">
      <ul role="list">
        {categories.map((cat) => <li><a href={`#${cat.id}`}>{cat.label}</a></li>)}
      </ul>
    </nav>

    <button type="button" class="cart-btn" aria-label="Carrito, 2 artículos">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <path d="M2.7 3h1.4l.6 8.2a1 1 0 0 0 1 .9h5.9a1 1 0 0 0 1-.85L13.4 6H4.5" stroke-linecap="round" stroke-linejoin="round"></path>
        <circle cx="6.2" cy="13.6" r="0.9"></circle>
        <circle cx="11" cy="13.6" r="0.9"></circle>
      </svg>
      <span class="cart-badge">2</span>
    </button>
  </header>

  <section class="hero">
    <div class="hero-media">
      <img
        class="hero-photo"
        src="/images/tiendaRopa/hearder/hearder.png"
        alt="Grupo de amigos con ropa urbana oversize riendo en un callejón"
        fetchpriority="high"
      />
    </div>

    <div class="hero-content">
      <p class="hero-kicker">Nueva colección</p>
      <h1 class="hero-title">La calle también tiene estilo propio</h1>
      <p class="hero-line">Streetwear oversize, denim ancho y calzado urbano, pensados para llevarse todos los días.</p>
      <div class="hero-actions">
        <a class="btn-solid" href="#camisetas">Ver colección</a>
        <a class="btn-outline" href="#calzado">Calzado</a>
      </div>
    </div>
  </section>

  <section class="perks">
    {
      perks.map((perk) => (
        <div class="perk">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path d="M3.5 8.5 6.5 11.5 12.5 4.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <div>
            <strong>{perk.title}</strong>
            <span>{perk.text}</span>
          </div>
        </div>
      ))
    }
  </section>

  {
    categories.map((cat, i) => (
      <section class={`category ${i % 2 === 1 ? 'is-alt' : ''}`} id={cat.id}>
        <header class="category-head">
          <p class="kicker">
            {cat.label} · {cat.products.length}
          </p>
          <h2>{cat.text}</h2>
        </header>

        <div class="grid">
          {cat.products.map((product) => (
            <article class="product">
              <div class="product-photo">
                <img src={product.src} alt={product.name} loading="lazy" decoding="async" />
                <button type="button" class="quick-add" aria-label={`Añadir ${product.name} al carrito`}>
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M8 3.5v9M3.5 8h9" stroke-linecap="round" />
                  </svg>
                </button>
              </div>
              <div class="product-body">
                <h3>{product.name}</h3>
                <span>{product.price}</span>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))
  }

  <section class="newsletter">
    <h2>Sé el primero en verlo</h2>
    <p>Lanzamientos y restocks antes que nadie, un correo cada dos semanas.</p>
    <form class="newsletter-form" onsubmit="return false">
      <label class="visually-hidden" for="fashion01-email">Correo electrónico</label>
      <input id="fashion01-email" type="email" placeholder="tu@email.com" autocomplete="email" />
      <button type="submit">Suscribirme</button>
    </form>
  </section>

  <footer class="footer">
    <div class="footer-top">
      <a class="brand" href="#">CONCRETO</a>
      <nav aria-label="Secciones">
        <ul role="list">
          {categories.map((cat) => <li><a href={`#${cat.id}`}>{cat.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <span>© 2026 Concreto</span>
      <ul role="list">
        <li><a href="#">Envíos</a></li>
        <li><a href="#">Devoluciones</a></li>
        <li><a href="#">Privacidad</a></li>
      </ul>
    </div>
  </footer>
</div>

<style>
  .site {
    position: relative;
    background: #ffffff;
    color: #111111;
    font-family: var(--font-sans);
  }

  /* --- Topbar: flota sobre el hero, anclada al mismo contenedor --- */
  .topbar {
    position: absolute;
    z-index: 3;
    top: 0;
    right: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 32px;
  }

  .brand {
    color: #fff;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  .topbar nav ul {
    display: flex;
    gap: 24px;
    margin: 0;
    list-style: none;
    padding: 0;
  }

  .topbar nav a {
    color: rgb(255 255 255 / 0.85);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .topbar nav a:hover {
    color: #fff;
  }

  .cart-btn {
    position: relative;
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 999px;
    color: #fff;
    transition: border-color 200ms ease, background-color 200ms ease;
  }

  .cart-btn:hover {
    background: rgb(255 255 255 / 0.12);
  }

  .cart-btn svg {
    width: 16px;
    height: 16px;
  }

  .cart-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    display: grid;
    min-width: 17px;
    height: 17px;
    place-items: center;
    border: 2px solid #111;
    border-radius: 999px;
    background: var(--primary-color);
    color: var(--primary-contrast);
    font-size: 9.5px;
    font-weight: 700;
  }

  /* --- Hero: la foto se disuelve en el fondo blanco --- */
  .hero {
    position: relative;
    height: 680px;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
  }

  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    mask-image: linear-gradient(to bottom, #000 0%, #000 44%, transparent 92%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 44%, transparent 92%);
  }

  @supports (animation-timeline: scroll()) {
    .hero-photo {
      animation: hero-scroll-fade linear forwards;
      animation-timeline: scroll(root block);
      animation-range: 0 65vh;
    }

    @keyframes hero-scroll-fade {
      to {
        opacity: 0.3;
        transform: scale(1.08);
      }
    }
  }

  .hero::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(180deg, rgb(10 8 4 / 0.4) 0%, rgb(10 8 4 / 0.04) 30%, rgb(255 255 255 / 0.08) 58%, #fff 100%);
    content: '';
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 24px;
    text-align: center;
  }

  .hero-kicker {
    margin: 0;
    color: rgb(255 255 255 / 0.9);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .hero-title {
    max-width: 16ch;
    margin: 18px 0 0;
    color: #fff;
    font-size: clamp(32px, 5cqi + 16px, 58px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .hero-line {
    max-width: 42ch;
    margin: 18px 0 0;
    color: rgb(255 255 255 / 0.85);
    font-size: 15px;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
  }

  .btn-solid {
    border-radius: 999px;
    background: #fff;
    padding: 12px 24px;
    color: #111;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: transform 180ms ease;
  }

  .btn-solid:hover {
    transform: translateY(-1px);
  }

  .btn-outline {
    display: inline-block;
    border: 1px solid rgb(255 255 255 / 0.55);
    border-radius: 999px;
    padding: 12px 22px;
    color: #fff;
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 200ms ease;
  }

  .hero-actions .btn-outline:hover {
    background: rgb(255 255 255 / 0.12);
  }

  /* --- Garantías --- */
  .perks {
    display: grid;
    gap: 1px;
    background: #ececec;
    grid-template-columns: repeat(3, 1fr);
  }

  .perk {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: #fff;
    padding: 20px 24px;
  }

  .perk svg {
    width: 17px;
    height: 17px;
    flex: none;
    margin-top: 2px;
    color: var(--primary-color);
  }

  .perk strong {
    display: block;
    font-size: 13.5px;
    font-weight: 700;
  }

  .perk span {
    display: block;
    margin-top: 3px;
    color: #6b6b6b;
    font-size: 12px;
  }

  /* --- Categorías --- */
  .category {
    padding: 64px 32px;
  }

  .category.is-alt {
    background: #f6f5f2;
  }

  .category-head {
    max-width: 620px;
    margin: 0 auto 32px;
  }

  .kicker {
    margin: 0;
    color: var(--primary-color);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .category-head h2 {
    margin: 10px 0 0;
    font-size: clamp(20px, 2.2cqi + 13px, 26px);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.35;
    max-width: 44ch;
  }

  .grid {
    display: grid;
    max-width: 1180px;
    gap: 22px;
    margin-inline: auto;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
  }

  .product-photo {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid #eae8e3;
    border-radius: 10px;
    background: #f4f3f0;
  }

  .product-photo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 14px;
    transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .product:hover .product-photo img {
    transform: scale(1.05);
  }

  .quick-add {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border-radius: 999px;
    background: #111;
    color: #fff;
    opacity: 0;
    box-shadow: 0 6px 16px -6px rgb(0 0 0 / 0.35);
    transition: opacity 200ms ease, transform 200ms ease;
    transform: translateY(4px);
  }

  .product:hover .quick-add {
    opacity: 1;
    transform: translateY(0);
  }

  .quick-add svg {
    width: 14px;
    height: 14px;
  }

  .product-body {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    padding-top: 12px;
  }

  .product-body h3 {
    margin: 0;
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.4;
  }

  .product-body span {
    flex: none;
    color: var(--primary-color);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
  }

  /* --- Newsletter --- */
  .newsletter {
    max-width: 520px;
    margin: 0 auto;
    padding: 20px 24px 84px;
    text-align: center;
  }

  .newsletter h2 {
    margin: 0;
    font-size: clamp(22px, 2.4cqi + 13px, 28px);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .newsletter p {
    margin: 10px 0 0;
    color: #6b6b6b;
    font-size: 13.5px;
  }

  .newsletter-form {
    display: flex;
    max-width: 380px;
    gap: 8px;
    margin: 22px auto 0;
    border: 1px solid #dedcd6;
    border-radius: 999px;
    padding: 6px;
  }

  .newsletter-form:focus-within {
    border-color: #111;
  }

  .newsletter-form input {
    min-width: 0;
    flex: 1;
    border: 0;
    background: none;
    padding: 9px 14px;
    color: #111;
    font-size: 14px;
    outline: none;
  }

  .newsletter-form button {
    flex: none;
    border: 0;
    border-radius: 999px;
    background: #111;
    padding: 10px 18px;
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 180ms ease;
  }

  .newsletter-form button:hover {
    background: color-mix(in srgb, #111 85%, var(--primary-color));
  }

  /* --- Footer --- */
  .footer {
    border-top: 1px solid #ececec;
    background: #111;
    color: rgb(255 255 255 / 0.7);
    padding: 44px 32px 24px;
  }

  .footer-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .footer .brand {
    color: #fff;
  }

  .footer-top nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin: 0;
    list-style: none;
    padding: 0;
  }

  .footer-top nav a {
    color: rgb(255 255 255 / 0.7);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .footer-top nav a:hover {
    color: #fff;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: 12px;
  }

  .footer-bottom ul {
    display: flex;
    gap: 16px;
    margin: 0;
    list-style: none;
    padding: 0;
  }

  .footer-bottom a {
    color: rgb(255 255 255 / 0.55);
    text-decoration: none;
  }

  .footer-bottom a:hover {
    color: #fff;
  }

  @container preview (max-width: 780px) {
    .perks {
      grid-template-columns: 1fr;
    }
  }

  @container preview (max-width: 640px) {
    .topbar {
      flex-wrap: wrap;
      gap: 12px;
      padding: 16px 20px;
    }

    .topbar nav ul {
      gap: 14px;
      overflow-x: auto;
    }

    .hero {
      height: 560px;
    }

    .category {
      padding: 48px 18px;
    }

    .footer {
      padding: 36px 20px 20px;
    }
  }
</style>
