---
interface Props {
  title?: string;
  text?: string;
}

const { title = 'Bienvenido de nuevo', text = 'Introduce tus datos para acceder al panel.' } = Astro.props;
---

<div class="wrap">
  <form class="card" onsubmit="return false">
    <h2 class="title">{title}</h2>
    <p class="text">{text}</p>

    <div class="social">
      <button type="button" class="social-btn">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path
            fill="#4285F4"
            d="M15.5 8.18c0-.57-.05-1.11-.14-1.64H8v3.1h4.2a3.6 3.6 0 0 1-1.56 2.36v1.96h2.52c1.48-1.36 2.34-3.37 2.34-5.78Z"
          ></path>
          <path
            fill="#34A853"
            d="M8 15.5c2.1 0 3.87-.7 5.16-1.9l-2.52-1.96c-.7.47-1.6.75-2.64.75-2.03 0-3.75-1.37-4.36-3.21H1.03v2.02A7.5 7.5 0 0 0 8 15.5Z"
          ></path>
          <path fill="#FBBC05" d="M3.64 8.68a4.5 4.5 0 0 1 0-2.87V3.79H1.03a7.5 7.5 0 0 0 0 6.9l2.61-2.01Z"></path>
          <path
            fill="#EA4335"
            d="M8 2.6c1.14 0 2.17.39 2.98 1.16l2.23-2.23A7.1 7.1 0 0 0 8 .5a7.5 7.5 0 0 0-6.97 4.79l2.61 2.02C4.25 3.98 5.97 2.6 8 2.6Z"
          ></path>
        </svg>
        Google
      </button>
      <button type="button" class="social-btn">
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 .8a7.2 7.2 0 0 0-2.28 14.03c.36.07.49-.16.49-.34v-1.36c-2 .43-2.42-.86-2.42-.86-.33-.83-.8-1.06-.8-1.06-.65-.45.05-.44.05-.44.73.05 1.11.75 1.11.75.64 1.1 1.68.78 2.1.6.06-.47.25-.78.46-.96-1.6-.18-3.28-.8-3.28-3.55 0-.78.28-1.42.74-1.93-.08-.18-.32-.9.07-1.89 0 0 .6-.19 1.98.73a6.9 6.9 0 0 1 3.6 0c1.38-.92 1.98-.73 1.98-.73.4.99.15 1.71.07 1.89.46.51.74 1.15.74 1.93 0 2.76-1.68 3.36-3.28 3.54.26.22.49.66.49 1.33v1.96c0 .19.13.42.5.34A7.2 7.2 0 0 0 8 .8Z"
          ></path>
        </svg>
        GitHub
      </button>
    </div>

    <div class="divider"><span>o con tu correo</span></div>

    <div class="field">
      <label for="form01-email">Correo electrónico</label>
      <input id="form01-email" type="email" placeholder="tu@empresa.com" autocomplete="email" required />
    </div>

    <div class="field">
      <div class="field-head">
        <label for="form01-password">Contraseña</label>
        <a href="#">¿La olvidaste?</a>
      </div>
      <input id="form01-password" type="password" placeholder="••••••••" autocomplete="current-password" required />
    </div>

    <label class="remember">
      <input type="checkbox" checked />
      Mantener sesión iniciada
    </label>

    <button type="submit" class="submit">Iniciar sesión</button>

    <p class="footnote">¿No tienes cuenta? <a href="#">Crear una</a></p>
  </form>
</div>

<style>
  .wrap {
    display: grid;
    place-items: center;
    background: var(--background-color);
    padding: 40px 20px;
    font-family: var(--font-sans);
  }

  .card {
    width: 100%;
    max-width: 380px;
    border: 1px solid var(--border-color);
    border-radius: 18px;
    background: var(--surface-color);
    padding: 30px 28px;
    box-shadow: var(--shadow-lg);
  }

  .title {
    margin: 0;
    color: var(--text-color);
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .text {
    margin: 7px 0 0;
    color: var(--text-muted);
    font-size: 13.5px;
    line-height: 1.5;
  }

  .social {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 22px;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid var(--border-color);
    border-radius: 9px;
    background: var(--surface-color);
    padding: 9px;
    color: var(--text-color);
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  .social-btn:hover {
    border-color: var(--primary-line);
    background: var(--surface-alt);
  }

  .social-btn svg {
    width: 15px;
    height: 15px;
  }

  .divider {
    position: relative;
    margin: 22px 0;
    text-align: center;
  }

  .divider::before {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--border-color);
    content: '';
  }

  .divider span {
    position: relative;
    background: var(--surface-color);
    padding: 0 10px;
    color: var(--text-muted);
    font-size: 12px;
  }

  .field {
    margin-top: 14px;
  }

  .field-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .field-head a {
    color: var(--primary-color);
    font-size: 12.5px;
    font-weight: 500;
    text-decoration: none;
  }

  .field label {
    display: block;
    margin-bottom: 6px;
    color: var(--text-color);
    font-size: 13px;
    font-weight: 600;
  }

  .field input {
    width: 100%;
    border: 1px solid var(--border-color);
    border-radius: 9px;
    background: var(--surface-color);
    padding: 10px 12px;
    color: var(--text-color);
    font-size: 14px;
    outline: none;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .field input:focus {
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px var(--primary-soft);
  }

  .remember {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    color: var(--text-muted);
    font-size: 13px;
  }

  .remember input {
    accent-color: var(--primary-color);
  }

  .submit {
    width: 100%;
    margin-top: 20px;
    border: 0;
    border-radius: 9px;
    background: var(--primary-color);
    padding: 11px;
    color: var(--primary-contrast);
    font-family: inherit;
    font-size: 14.5px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 160ms ease;
  }

  .submit:hover {
    background: var(--primary-hover);
  }

  .footnote {
    margin: 18px 0 0;
    color: var(--text-muted);
    font-size: 13px;
    text-align: center;
  }

  .footnote a {
    color: var(--primary-color);
    font-weight: 600;
    text-decoration: none;
  }
</style>
