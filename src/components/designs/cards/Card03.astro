---
import { team } from '@/data/sample';

interface Props {
  members?: typeof team;
}

const { members = team } = Astro.props;
---

<div class="grid">
  {
    members.map((person) => (
      <article class="card" style={`--tone:${person.tone}`}>
        <span class="avatar" aria-hidden="true">
          {person.initials}
        </span>

        <h3 class="name">{person.name}</h3>
        <p class="role">{person.role}</p>
        <p class="bio">{person.bio}</p>

        <div class="social">
          <a href="#" aria-label="LinkedIn">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M2.9 5.6h2v7.7h-2zM3.9 2.5a1.16 1.16 0 1 1 0 2.32 1.16 1.16 0 0 1 0-2.32ZM6.9 5.6h1.92v1.05h.03c.27-.5.92-1.03 1.9-1.03 2.03 0 2.4 1.3 2.4 3v4.65h-2V8.98c0-.73-.01-1.67-1.03-1.67-1.03 0-1.19.79-1.19 1.62v4.4h-2Z" />
            </svg>
          </a>
          <a href="#" aria-label="X (Twitter)">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M9.53 6.9 13.7 2h-1.3L8.94 6.06 6.13 2H2.3l4.37 6.24L2.3 13.4h1.3l3.66-4.3 3 4.3h3.83L9.53 6.9Zm-1.3 1.5-.42-.6-3.4-4.83h1.61l2.72 3.9.42.58 3.55 5.07H11.1L8.23 8.4Z" />
            </svg>
          </a>
          <a href="#" aria-label="GitHub">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 1.6a6.9 6.9 0 0 0-2.18 13.44c.35.06.47-.15.47-.33v-1.3c-1.92.42-2.33-.82-2.33-.82-.31-.8-.77-1.02-.77-1.02-.63-.43.05-.42.05-.42.7.05 1.06.71 1.06.71.62 1.06 1.62.76 2.02.58.06-.45.24-.76.44-.93-1.53-.17-3.14-.77-3.14-3.4 0-.75.27-1.36.7-1.85-.07-.17-.3-.87.07-1.81 0 0 .58-.19 1.9.7a6.6 6.6 0 0 1 3.46 0c1.32-.89 1.9-.7 1.9-.7.37.94.14 1.64.07 1.81.44.49.7 1.1.7 1.85 0 2.64-1.62 3.22-3.15 3.4.25.21.47.63.47 1.27v1.88c0 .18.12.4.48.33A6.9 6.9 0 0 0 8 1.6Z" />
            </svg>
          </a>
        </div>
      </article>
    ))
  }
</div>

<style>
  .grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    font-family: var(--font-sans);
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    border: 1px solid var(--border-color);
    border-radius: 16px;
    background: var(--surface-color);
    box-shadow: var(--shadow-sm);
    padding: 22px 20px;
    transition: box-shadow 220ms ease, transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 220ms ease;
  }

  .card:hover {
    border-color: var(--primary-line);
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .avatar {
    display: grid;
    width: 52px;
    height: 52px;
    place-items: center;
    border-radius: 999px;
    background: linear-gradient(
      calc((135 + var(--tone) * 75) * 1deg),
      color-mix(in srgb, var(--primary-color) 85%, #000 5%),
      color-mix(in srgb, var(--primary-color) 35%, var(--surface-alt))
    );
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .name {
    margin: 16px 0 0;
    color: var(--text-color);
    font-size: 15.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .role {
    margin: 3px 0 0;
    color: var(--primary-color);
    font-size: 12.5px;
    font-weight: 600;
  }

  .bio {
    margin: 10px 0 0;
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .social {
    display: flex;
    gap: 6px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border-color);
    width: 100%;
  }

  .social a {
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border-radius: 999px;
    color: var(--text-muted);
    transition: background-color 180ms ease, color 180ms ease;
  }

  .social a:hover {
    background: var(--primary-light);
    color: var(--primary-color);
  }

  .social svg {
    width: 14px;
    height: 14px;
  }
</style>
