---
import { showcase } from '@/data/sample';

interface Props {
  items?: typeof showcase;
}

const { items = showcase } = Astro.props;
---

<div class="grid">
  {
    items.map((item) => (
      <article class="card" style={`--tone:${item.tone}`}>
        <div class="canvas" aria-hidden="true">
          <span class="ring" />
          <span class="ring ring-2" />
        </div>

        <span class="badge">{item.badge}</span>

        <div class="content">
          <p class="meta">{item.meta}</p>
          <h3 class="title">
            <a href="#">{item.title}</a>
          </h3>
          <p class="excerpt">{item.excerpt}</p>
        </div>

        <span class="go" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4.5 11.5 11.5 4.5M6 4.5h5.5V10" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </article>
    ))
  }
</div>

<style>
  .grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr));
    font-family: var(--font-sans);
  }

  .card {
    position: relative;
    display: flex;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    flex-direction: column;
    justify-content: flex-end;
    border-radius: 22px;
    background: var(--surface-alt);
    color: #fff;
    isolation: isolate;
    transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 260ms ease;
  }

  .card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  /* "Imagen" generada: degradado teñido con el color principal + anillos. */
  .canvas {
    position: absolute;
    z-index: -2;
    inset: 0;
    background: linear-gradient(
      calc((160 + var(--tone) * 60) * 1deg),
      color-mix(in srgb, var(--primary-color) 92%, #000 8%),
      color-mix(in srgb, var(--primary-color) 45%, #1b1c22)
    );
    transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .card:hover .canvas {
    transform: scale(1.06);
  }

  .ring {
    position: absolute;
    top: calc(-30px + var(--tone) * 60px);
    right: -60px;
    width: 240px;
    height: 240px;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: 999px;
  }

  .ring-2 {
    top: auto;
    right: auto;
    bottom: -110px;
    left: -80px;
    width: 300px;
    height: 300px;
    border-color: rgb(255 255 255 / 0.14);
  }

  .card::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(to top, rgb(10 11 15 / 0.88) 12%, rgb(10 11 15 / 0.15) 55%, transparent);
    content: '';
  }

  .badge {
    position: absolute;
    top: 16px;
    left: 16px;
    border-radius: 999px;
    /* Velo oscuro (no blanco): mantiene el contraste aunque el color
       principal elegido sea muy claro. */
    background: rgb(10 11 15 / 0.42);
    padding: 5px 11px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    backdrop-filter: blur(6px);
  }

  .content {
    padding: 20px;
  }

  .meta {
    margin: 0;
    color: rgb(255 255 255 / 0.72);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .title {
    margin: 7px 0 0;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .title a {
    color: inherit;
    text-decoration: none;
  }

  .title a::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  /* El resumen se revela al pasar el cursor o al enfocar con teclado. */
  .excerpt {
    max-height: 0;
    margin: 0;
    color: rgb(255 255 255 / 0.8);
    font-size: 13px;
    line-height: 1.55;
    opacity: 0;
    transition: max-height 300ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 220ms ease,
      margin-top 300ms ease;
  }

  .card:hover .excerpt,
  .card:focus-within .excerpt {
    max-height: 90px;
    margin-top: 8px;
    opacity: 1;
  }

  .go {
    position: absolute;
    top: 14px;
    right: 14px;
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 999px;
    background: var(--primary-color);
    color: var(--primary-contrast);
    transition: background-color 180ms ease, transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .go svg {
    width: 16px;
    height: 16px;
  }

  .card:hover .go {
    background: var(--primary-hover);
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .excerpt {
      max-height: 90px;
      margin-top: 8px;
      opacity: 1;
    }
  }
</style>
