---
// Blog editorial autocontenido: header, artículo destacado, filtro de
// categorías, rejilla de artículos y alta a la newsletter.
const categories = ['Todo', 'Ingeniería', 'Diseño', 'Producto', 'Cultura'];

const featured = {
  category: 'Ingeniería',
  title: 'Migrar un panel de control a islas de Astro',
  excerpt:
    'Qué partes de la interfaz merecen hidratarse y cuáles pueden quedarse en HTML puro sin perder interactividad. Un año después, esto es lo que cambiaríamos.',
  author: 'Nerea Salas',
  date: '3 ago 2026',
  readingTime: '6 min',
  tone: 0.2,
};

const articles = [
  {
    category: 'Diseño',
    title: 'Un sistema de color que aguanta el modo oscuro',
    author: 'Iván Bermúdez',
    date: '28 jul 2026',
    readingTime: '4 min',
    tone: 0.5,
  },
  {
    category: 'Producto',
    title: 'Medir la primera semana de uso, no el registro',
    author: 'Clara Ferrer',
    date: '21 jul 2026',
    readingTime: '8 min',
    tone: 0.8,
  },
  {
    category: 'Cultura',
    title: 'Reuniones que sobran: una auditoría de tres meses',
    author: 'Marcos Oyarzun',
    date: '14 jul 2026',
    readingTime: '5 min',
    tone: 0.05,
  },
  {
    category: 'Ingeniería',
    title: 'Cachés que mienten: un caso real de datos obsoletos',
    author: 'Nerea Salas',
    date: '9 jul 2026',
    readingTime: '7 min',
    tone: 0.65,
  },
  {
    category: 'Diseño',
    title: 'Componentes que se rompen bien: estados de error de verdad',
    author: 'Iván Bermúdez',
    date: '2 jul 2026',
    readingTime: '5 min',
    tone: 0.35,
  },
  {
    category: 'Producto',
    title: 'El roadmap que no enseñamos a nadie fuera del equipo',
    author: 'Clara Ferrer',
    date: '25 jun 2026',
    readingTime: '6 min',
    tone: 0.95,
  },
];
---

<div class="site">
  <header class="header">
    <a class="logo" href="#">Cuaderno</a>

    <nav class="nav" aria-label="Principal">
      <ul role="list">
        <li><a href="#">Archivo</a></li>
        <li><a href="#">Autores</a></li>
        <li><a href="#">Newsletter</a></li>
      </ul>
    </nav>

    <button type="button" class="icon-btn" aria-label="Buscar">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <circle cx="7" cy="7" r="4.3"></circle>
        <path d="m13 13-2.6-2.6" stroke-linecap="round"></path>
      </svg>
    </button>
  </header>

  <section class="featured">
    <div class="photo-tone featured-photo" style={`--tone:${featured.tone}`} aria-hidden="true">
      <span class="photo-shape"></span>
    </div>
    <div class="featured-body">
      <p class="eyebrow">Destacado · {featured.category}</p>
      <h1><a href="#">{featured.title}</a></h1>
      <p class="excerpt">{featured.excerpt}</p>
      <p class="meta">
        {featured.author} · {featured.date} · {featured.readingTime} de lectura
      </p>
    </div>
  </section>

  <nav class="chips" aria-label="Categorías">
    {categories.map((cat, i) => <a class={`chip ${i === 0 ? 'is-active' : ''}`} href="#">{cat}</a>)}
  </nav>

  <section class="articles">
    <div class="grid">
      {
        articles.map((article) => (
          <article class="card">
            <div class="photo-tone card-photo" style={`--tone:${article.tone}`} aria-hidden="true">
              <span class="photo-shape" />
            </div>
            <div class="card-body">
              <p class="card-category">{article.category}</p>
              <h3>
                <a href="#">{article.title}</a>
              </h3>
              <p class="card-meta">
                {article.author} · {article.readingTime} de lectura
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="newsletter">
    <h2>Un correo cada dos semanas, sin ruido</h2>
    <p>Los artículos nuevos y algún enlace que no publicamos en ningún otro sitio.</p>
    <form class="newsletter-form" onsubmit="return false">
      <label class="visually-hidden" for="blog01-email">Correo electrónico</label>
      <input id="blog01-email" type="email" placeholder="tu@email.com" autocomplete="email" />
      <button type="submit">Suscribirme</button>
    </form>
  </section>

  <footer class="footer">
    <span>© 2026 Cuaderno</span>
    <ul role="list">
      <li><a href="#">RSS</a></li>
      <li><a href="#">Privacidad</a></li>
    </ul>
  </footer>
</div>

<style>
  .site {
    background: var(--background-color);
    font-family: var(--font-sans);
  }

  .photo-tone {
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: linear-gradient(
      calc((130 + var(--tone) * 80) * 1deg),
      color-mix(in srgb, var(--primary-color) 88%, #000 4%),
      color-mix(in srgb, var(--primary-color) 30%, var(--surface-alt))
    );
  }

  .photo-tone::after {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(255 255 255 / 0.2) 1px, transparent 1px);
    background-size: 12px 12px;
    content: '';
  }

  .photo-shape {
    width: 30px;
    height: 30px;
    border: 2px solid rgb(255 255 255 / 0.6);
    border-radius: 999px;
  }

  /* --- Header --- */
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1px solid var(--border-color);
    padding: 16px 28px;
  }

  .logo {
    color: var(--text-color);
    font-family: var(--font-mono);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .nav ul {
    display: flex;
    gap: 22px;
    margin: 0;
    list-style: none;
    padding: 0;
  }

  .nav a {
    color: var(--text-muted);
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .nav a:hover {
    color: var(--text-color);
  }

  .icon-btn {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 999px;
    color: var(--text-muted);
    transition: background-color 180ms ease, color 180ms ease;
  }

  .icon-btn:hover {
    background: var(--surface-alt);
    color: var(--text-color);
  }

  .icon-btn svg {
    width: 16px;
    height: 16px;
  }

  /* --- Destacado --- */
  .featured {
    display: grid;
    max-width: 1080px;
    align-items: center;
    gap: 36px;
    margin-inline: auto;
    grid-template-columns: 1.1fr 1fr;
    padding: 48px 28px;
  }

  .featured-photo {
    aspect-ratio: 4 / 3;
    border-radius: 16px;
  }

  .eyebrow {
    margin: 0;
    color: var(--primary-color);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .featured-body h1 {
    max-width: 18ch;
    margin: 12px 0 0;
    font-size: clamp(24px, 3.4cqi + 14px, 34px);
  }

  .featured-body h1 a {
    color: var(--text-color);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-decoration: none;
    text-wrap: balance;
  }

  .excerpt {
    max-width: 46ch;
    margin: 14px 0 0;
    color: var(--text-muted);
    font-size: 14.5px;
    line-height: 1.65;
  }

  .meta {
    margin: 16px 0 0;
    color: var(--text-muted);
    font-size: 12.5px;
  }

  /* --- Chips --- */
  .chips {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    padding: 14px 28px;
  }

  .chip {
    flex: none;
    border-radius: 999px;
    padding: 6px 13px;
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .chip:hover {
    background: var(--surface-alt);
    color: var(--text-color);
  }

  .chip.is-active {
    background: var(--primary-light);
    color: color-mix(in srgb, var(--primary-color) 78%, var(--text-color));
  }

  /* --- Artículos --- */
  .articles {
    max-width: 1080px;
    margin-inline: auto;
    padding: 40px 28px 60px;
  }

  .grid {
    display: grid;
    gap: 22px;
    grid-template-columns: repeat(3, 1fr);
  }

  .card-photo {
    aspect-ratio: 16 / 10;
    border-radius: 12px;
  }

  .card-body {
    padding-top: 12px;
  }

  .card-category {
    margin: 0;
    color: var(--primary-color);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .card-body h3 {
    margin: 7px 0 0;
    font-size: 15.5px;
    line-height: 1.3;
  }

  .card-body h3 a {
    color: var(--text-color);
    font-weight: 600;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  .card-meta {
    margin: 8px 0 0;
    color: var(--text-muted);
    font-size: 12px;
  }

  /* --- Newsletter --- */
  .newsletter {
    max-width: 560px;
    margin: 0 auto;
    padding: 0 28px 64px;
    text-align: center;
  }

  .newsletter h2 {
    margin: 0;
    color: var(--text-color);
    font-size: clamp(20px, 2.4cqi + 12px, 26px);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .newsletter p {
    margin: 10px 0 0;
    color: var(--text-muted);
    font-size: 13.5px;
  }

  .newsletter-form {
    display: flex;
    max-width: 380px;
    gap: 8px;
    margin: 20px auto 0;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: var(--surface-color);
    padding: 6px;
  }

  .newsletter-form:focus-within {
    border-color: var(--primary-color);
  }

  .newsletter-form input {
    min-width: 0;
    flex: 1;
    border: 0;
    background: none;
    padding: 9px 10px;
    color: var(--text-color);
    font-size: 14px;
    outline: none;
  }

  .newsletter-form button {
    flex: none;
    border: 0;
    border-radius: 8px;
    background: var(--primary-color);
    padding: 10px 16px;
    color: var(--primary-contrast);
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 180ms ease;
  }

  .newsletter-form button:hover {
    background: var(--primary-hover);
  }

  /* --- Footer --- */
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid var(--border-color);
    padding: 20px 28px;
    color: var(--text-muted);
    font-size: 12.5px;
  }

  .footer ul {
    display: flex;
    gap: 18px;
    margin: 0;
    list-style: none;
    padding: 0;
  }

  .footer a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--text-color);
  }

  @container preview (max-width: 780px) {
    .featured {
      gap: 24px;
      grid-template-columns: 1fr;
      padding: 36px 20px;
    }

    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @container preview (max-width: 560px) {
    .header {
      flex-wrap: wrap;
      gap: 10px;
      padding: 14px 18px;
    }

    .chips,
    .articles {
      padding-inline: 18px;
    }

    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
