---
// Página de una sola pantalla: el header no enlaza a anclas que hacen scroll,
// sino a radios ocultos que revelan un panel de información distinto sobre
// el mismo fondo. `:has()` conecta el radio marcado (en el header) con el
// panel correspondiente (en el pie) sin una sola línea de JS.
//
// El fondo no es una foto: es un cielo estrellado, un resplandor de aurora y
// una cordillera de tres siluetas, todo generado con gradientes y
// `clip-path`. Igual que el resto de la galería, nunca se rompe.
interface Star {
  top: number;
  left: number;
  size: number;
  opacity: number;
  twinkle: boolean;
  delay: number;
}

function makeStars(count: number, size: [number, number], opacity: [number, number], twinkle = false): Star[] {
  return Array.from({ length: count }, () => ({
    top: Math.round(Math.random() * 520) / 10,
    left: Math.round(Math.random() * 1000) / 10,
    size: Math.round((size[0] + Math.random() * (size[1] - size[0])) * 10) / 10,
    opacity: Math.round((opacity[0] + Math.random() * (opacity[1] - opacity[0])) * 100) / 100,
    twinkle,
    delay: Math.round(Math.random() * 60) / 10,
  }));
}

const stars: Star[] = [
  ...makeStars(70, [1, 1.4], [0.25, 0.55]),
  ...makeStars(22, [1.6, 2.2], [0.5, 0.8]),
  ...makeStars(7, [2.4, 3], [0.8, 1], true),
];

interface Tab {
  id: string;
  label: string;
  eyebrow: string;
  title: string;
  text: string;
  stats?: { value: string; label: string }[];
  cta?: string;
}

const tabs: Tab[] = [
  {
    id: 'rutas',
    label: 'Rutas',
    eyebrow: 'Senderismo nocturno',
    title: 'Tres rutas hasta el mirador de estrellas',
    text: 'Cada una termina en el mismo punto: una explanada sin luz artificial a 2.400 m, justo cuando el cielo se abre sobre el paso.',
    stats: [
      { value: '3', label: 'rutas guiadas' },
      { value: '2.400 m', label: 'altitud' },
      { value: '4 h', label: 'duración' },
    ],
  },
  {
    id: 'guias',
    label: 'Guías',
    eyebrow: 'Equipo local',
    title: 'Guías certificados de montaña',
    text: 'Nacidos en Svaneti: conocen cada paso del sendero de noche y leen el cielo mejor que cualquier aplicación.',
    stats: [
      { value: '8', label: 'guías' },
      { value: '12 años', label: 'experiencia media' },
      { value: '100%', label: 'locales' },
    ],
  },
  {
    id: 'equipo',
    label: 'Equipo',
    eyebrow: 'Todo incluido',
    title: 'No necesitas traer nada',
    text: 'Linterna frontal, saco térmico, trípode y prismáticos van incluidos en el precio de cada salida nocturna.',
    stats: [
      { value: '4', label: 'artículos incluidos' },
      { value: '0 €', label: 'coste extra' },
      { value: '−5 °C', label: 'saco hasta' },
    ],
  },
  {
    id: 'reservar',
    label: 'Reservar',
    eyebrow: 'Plazas limitadas',
    title: 'Sólo 12 personas por noche',
    text: 'Reservamos pocas plazas para no perder la oscuridad del cielo. La próxima salida disponible es el sábado.',
    cta: 'Reservar plaza · 45 €',
  },
];
---

<section class="screen">
  <div class="milkyway" aria-hidden="true"></div>
  <div class="aurora-glow" aria-hidden="true"></div>

  <div class="stars" aria-hidden="true">
    {
      stars.map((star) => (
        <span
          class={`star ${star.twinkle ? 'star-twinkle' : ''}`}
          style={
            star.twinkle
              ? `top:${star.top}%; left:${star.left}%; width:${star.size}px; height:${star.size}px; animation-delay:${star.delay}s;`
              : `top:${star.top}%; left:${star.left}%; width:${star.size}px; height:${star.size}px; opacity:${star.opacity};`
          }
        />
      ))
    }
  </div>

  <div class="mountains" aria-hidden="true">
    <div class="ridge ridge-far"></div>
    <div class="ridge ridge-mid"></div>
    <div class="ridge ridge-near"></div>
  </div>

  <header class="header">
    <a class="logo" href="#">
      <svg class="logo-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 18 9 9l4 5 3-4 5 8H3Z"></path>
        <path d="M17 5l.8 1.8L19.6 7l-1.8.8L17 9.6l-.8-1.8L14.4 7l1.8-.8L17 5Z"></path>
      </svg>
      Aurora Basecamp
    </a>

    <nav class="nav" aria-label="Secciones">
      {
        tabs.map((tab, i) => (
          <span class="tab-item">
            <input type="radio" name="page01-tab" id={`page01-${tab.id}`} checked={i === 0} />
            <label for={`page01-${tab.id}`}>{tab.label}</label>
          </span>
        ))
      }
    </nav>
  </header>

  <div class="hero-copy">
    <p class="eyebrow">
      <span class="eyebrow-dot" aria-hidden="true"></span>
      Campamento base · Cáucaso
    </p>
    <h1>Duerme bajo la Vía Láctea, despierta sobre las nubes</h1>
    <p class="location">Paso de Goulet · Svaneti, Georgia</p>
  </div>

  <div class="panels">
    {
      tabs.map((tab) => (
        <article class="panel" data-panel={tab.id}>
          <p class="panel-eyebrow">{tab.eyebrow}</p>
          <h2 class="panel-title">{tab.title}</h2>
          <p class="panel-text">{tab.text}</p>
          {tab.cta ? (
            <a class="panel-cta" href="#">
              {tab.cta}
            </a>
          ) : (
            <div class="panel-stats">
              {tab.stats?.map((stat) => (
                <div class="panel-stat">
                  <strong>{stat.value}</strong>
                  <span>{stat.label}</span>
                </div>
              ))}
            </div>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .screen {
    position: relative;
    overflow: hidden;
    height: 640px;
    border-radius: 20px;
    background: linear-gradient(
      180deg,
      #05060f 0%,
      #0a0b1f 20%,
      #221a3c 40%,
      #6c2f52 56%,
      #c85a3f 70%,
      #eb9660 82%,
      #f6c88f 94%,
      #f8dba8 100%
    );
    font-family: var(--font-sans);
    isolation: isolate;
  }

  .screen::before {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(180deg, rgb(6 8 20 / 0.55) 0%, rgb(6 8 20 / 0.05) 30%, rgb(6 8 20 / 0.1) 52%, rgb(6 8 20 / 0.5) 100%);
    content: '';
  }

  /* --- Cielo: vía láctea, resplandor de aurora, estrellas y montañas --- */
  .milkyway {
    position: absolute;
    z-index: 0;
    inset: -15% -25%;
    background: linear-gradient(
      100deg,
      transparent 40%,
      rgb(255 255 255 / 0.04) 46%,
      rgb(224 228 255 / 0.13) 50%,
      rgb(255 255 255 / 0.04) 54%,
      transparent 60%
    );
    filter: blur(5px);
    mix-blend-mode: screen;
    transform: rotate(-9deg);
  }

  .aurora-glow {
    position: absolute;
    z-index: 0;
    inset: 0;
    background: radial-gradient(48% 34% at 28% 26%, rgb(214 122 190 / 0.32), transparent 72%),
      radial-gradient(46% 30% at 76% 18%, rgb(110 205 175 / 0.18), transparent 72%);
    mix-blend-mode: screen;
    animation: aurora-drift 24s ease-in-out infinite;
  }

  @keyframes aurora-drift {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }

    50% {
      transform: translateY(-2%) scale(1.05);
    }
  }

  .stars {
    position: absolute;
    z-index: 0;
    inset: 0;
  }

  .star {
    position: absolute;
    border-radius: 999px;
    background: #fff;
  }

  .star-twinkle {
    box-shadow: 0 0 5px 1px rgb(255 255 255 / 0.55);
    animation: twinkle 4.5s ease-in-out infinite;
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.35;
    }

    50% {
      opacity: 1;
    }
  }

  .mountains {
    position: absolute;
    z-index: 0;
    right: 0;
    bottom: 0;
    left: 0;
    height: 46%;
  }

  .ridge {
    position: absolute;
    inset: 0;
  }

  .ridge-far {
    background: #3c3564;
    clip-path: polygon(
      0% 100%,
      0% 58%,
      8% 42%,
      16% 54%,
      25% 32%,
      34% 50%,
      43% 22%,
      52% 46%,
      61% 26%,
      70% 44%,
      80% 18%,
      90% 40%,
      100% 24%,
      100% 100%
    );
    opacity: 0.85;
  }

  .ridge-mid {
    background: #221d3d;
    clip-path: polygon(
      0% 100%,
      0% 72%,
      11% 56%,
      21% 70%,
      31% 46%,
      41% 64%,
      50% 40%,
      60% 60%,
      70% 38%,
      80% 58%,
      90% 44%,
      100% 62%,
      100% 100%
    );
  }

  .ridge-near {
    background: #100f1c;
    clip-path: polygon(
      0% 100%,
      0% 82%,
      13% 70%,
      24% 84%,
      36% 62%,
      48% 80%,
      60% 58%,
      72% 78%,
      84% 64%,
      94% 82%,
      100% 72%,
      100% 100%
    );
  }

  .header {
    position: absolute;
    z-index: 2;
    top: 0;
    right: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 28px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .logo-mark {
    width: 19px;
    height: 19px;
  }

  .nav {
    display: flex;
    gap: 2px;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 999px;
    background: rgb(10 12 22 / 0.35);
    padding: 4px;
    backdrop-filter: blur(10px);
  }

  .tab-item input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .tab-item label {
    display: block;
    border-radius: 999px;
    padding: 8px 15px;
    color: rgb(255 255 255 / 0.72);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 220ms ease, color 220ms ease;
  }

  .tab-item label:hover {
    color: #fff;
  }

  .tab-item input:checked + label {
    background: rgb(255 255 255 / 0.16);
    color: #fff;
  }

  .tab-item input:focus-visible + label {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .hero-copy {
    position: absolute;
    z-index: 2;
    bottom: 34px;
    left: 32px;
    max-width: 30ch;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: rgb(255 255 255 / 0.82);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--primary-color);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary-color) 40%, transparent);
  }

  .hero-copy h1 {
    margin: 14px 0 0;
    color: #fff;
    font-size: clamp(24px, 3.6cqi + 12px, 36px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .location {
    margin: 12px 0 0;
    color: rgb(255 255 255 / 0.6);
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
  }

  .panels {
    position: absolute;
    z-index: 2;
    right: 28px;
    bottom: 30px;
    display: grid;
    width: 300px;
  }

  .panel {
    grid-area: 1 / 1;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 16px;
    background: rgb(10 11 20 / 0.5);
    padding: 20px 22px;
    opacity: 0;
    color: #fff;
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    transform: translateY(14px);
    transition: opacity 420ms cubic-bezier(0.2, 0.8, 0.2, 1), transform 420ms cubic-bezier(0.2, 0.8, 0.2, 1);
    pointer-events: none;
  }

  .screen:has(#page01-rutas:checked) .panel[data-panel='rutas'],
  .screen:has(#page01-guias:checked) .panel[data-panel='guias'],
  .screen:has(#page01-equipo:checked) .panel[data-panel='equipo'],
  .screen:has(#page01-reservar:checked) .panel[data-panel='reservar'] {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .panel-eyebrow {
    margin: 0;
    color: color-mix(in srgb, var(--primary-color) 55%, #fff 45%);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .panel-title {
    margin: 8px 0 0;
    font-size: 16.5px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .panel-text {
    margin: 8px 0 0;
    color: rgb(255 255 255 / 0.72);
    font-size: 12.5px;
    line-height: 1.55;
  }

  .panel-stats {
    display: flex;
    gap: 16px;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  .panel-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .panel-stat strong {
    font-size: 14px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .panel-stat span {
    color: rgb(255 255 255 / 0.55);
    font-size: 10.5px;
  }

  .panel-cta {
    display: inline-flex;
    margin-top: 16px;
    border-radius: 10px;
    background: var(--primary-color);
    padding: 10px 16px;
    color: var(--primary-contrast);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 180ms ease;
  }

  .panel-cta:hover {
    background: var(--primary-hover);
  }

  @container preview (max-width: 860px) {
    .panels {
      width: 260px;
    }

    .hero-copy {
      max-width: 24ch;
    }
  }

  @container preview (max-width: 640px) {
    .screen {
      height: auto;
      border-radius: 16px;
    }

    .header,
    .hero-copy,
    .panels {
      position: static;
    }

    .header {
      flex-wrap: wrap;
      gap: 10px;
      padding: 18px 18px 14px;
    }

    .nav {
      width: 100%;
      justify-content: space-between;
    }

    .tab-item label {
      padding: 8px 10px;
      font-size: 12px;
    }

    .hero-copy {
      max-width: none;
      padding: 18px 18px 0;
    }

    .panels {
      width: auto;
      padding: 22px 18px 26px;
    }
  }
</style>
