---
// Página de una sola pantalla: el header no enlaza a anclas que hacen scroll,
// sino a radios ocultos que revelan un panel de información distinto sobre
// la misma foto. `:has()` conecta el radio marcado (en el header) con el
// panel correspondiente (en el pie de la foto) sin una sola línea de JS.
interface Tab {
  id: string;
  label: string;
  eyebrow: string;
  title: string;
  text: string;
  stats?: { value: string; label: string }[];
  cta?: string;
}

const tabs: Tab[] = [
  {
    id: 'rutas',
    label: 'Rutas',
    eyebrow: 'Senderismo nocturno',
    title: 'Tres rutas hasta el mirador de estrellas',
    text: 'Cada una termina en el mismo punto: una explanada sin luz artificial a 2.400 m, justo cuando el cielo se abre sobre el paso.',
    stats: [
      { value: '3', label: 'rutas guiadas' },
      { value: '2.400 m', label: 'altitud' },
      { value: '4 h', label: 'duración' },
    ],
  },
  {
    id: 'guias',
    label: 'Guías',
    eyebrow: 'Equipo local',
    title: 'Guías certificados de montaña',
    text: 'Nacidos en Svaneti: conocen cada paso del sendero de noche y leen el cielo mejor que cualquier aplicación.',
    stats: [
      { value: '8', label: 'guías' },
      { value: '12 años', label: 'experiencia media' },
      { value: '100%', label: 'locales' },
    ],
  },
  {
    id: 'equipo',
    label: 'Equipo',
    eyebrow: 'Todo incluido',
    title: 'No necesitas traer nada',
    text: 'Linterna frontal, saco térmico, trípode y prismáticos van incluidos en el precio de cada salida nocturna.',
    stats: [
      { value: '4', label: 'artículos incluidos' },
      { value: '0 €', label: 'coste extra' },
      { value: '−5 °C', label: 'saco hasta' },
    ],
  },
  {
    id: 'reservar',
    label: 'Reservar',
    eyebrow: 'Plazas limitadas',
    title: 'Sólo 12 personas por noche',
    text: 'Reservamos pocas plazas para no perder la oscuridad del cielo. La próxima salida disponible es el sábado.',
    cta: 'Reservar plaza · 45 €',
  },
];
---

<section class="screen">
  <header class="header">
    <a class="logo" href="#">
      <svg class="logo-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 18 9 9l4 5 3-4 5 8H3Z"></path>
        <path d="M17 5l.8 1.8L19.6 7l-1.8.8L17 9.6l-.8-1.8L14.4 7l1.8-.8L17 5Z"></path>
      </svg>
      Aurora Basecamp
    </a>

    <nav class="nav" aria-label="Secciones">
      {
        tabs.map((tab, i) => (
          <span class="tab-item">
            <input type="radio" name="page01-tab" id={`page01-${tab.id}`} checked={i === 0} />
            <label for={`page01-${tab.id}`}>{tab.label}</label>
          </span>
        ))
      }
    </nav>
  </header>

  <div class="hero-copy">
    <p class="eyebrow">
      <span class="eyebrow-dot" aria-hidden="true"></span>
      Campamento base · Cáucaso
    </p>
    <h1>Duerme bajo la Vía Láctea, despierta sobre las nubes</h1>
    <p class="location">Paso de Goulet · Svaneti, Georgia</p>
  </div>

  <div class="panels">
    {
      tabs.map((tab) => (
        <article class="panel" data-panel={tab.id}>
          <p class="panel-eyebrow">{tab.eyebrow}</p>
          <h2 class="panel-title">{tab.title}</h2>
          <p class="panel-text">{tab.text}</p>
          {tab.cta ? (
            <a class="panel-cta" href="#">
              {tab.cta}
            </a>
          ) : (
            <div class="panel-stats">
              {tab.stats?.map((stat) => (
                <div class="panel-stat">
                  <strong>{stat.value}</strong>
                  <span>{stat.label}</span>
                </div>
              ))}
            </div>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .screen {
    position: relative;
    overflow: hidden;
    height: 640px;
    border-radius: 20px;
    background-image: url('/images/hero-aurora.jpg');
    background-position: center 62%;
    background-size: cover;
    font-family: var(--font-sans);
    isolation: isolate;
  }

  .screen::before {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(180deg, rgb(6 8 20 / 0.6) 0%, rgb(6 8 20 / 0.08) 32%, rgb(6 8 20 / 0.15) 55%, rgb(6 8 20 / 0.82) 100%);
    content: '';
  }

  .header {
    position: absolute;
    z-index: 2;
    top: 0;
    right: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 28px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .logo-mark {
    width: 19px;
    height: 19px;
  }

  .nav {
    display: flex;
    gap: 2px;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 999px;
    background: rgb(10 12 22 / 0.35);
    padding: 4px;
    backdrop-filter: blur(10px);
  }

  .tab-item input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .tab-item label {
    display: block;
    border-radius: 999px;
    padding: 8px 15px;
    color: rgb(255 255 255 / 0.72);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 220ms ease, color 220ms ease;
  }

  .tab-item label:hover {
    color: #fff;
  }

  .tab-item input:checked + label {
    background: rgb(255 255 255 / 0.16);
    color: #fff;
  }

  .tab-item input:focus-visible + label {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .hero-copy {
    position: absolute;
    z-index: 2;
    bottom: 34px;
    left: 32px;
    max-width: 30ch;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: rgb(255 255 255 / 0.82);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--primary-color);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary-color) 40%, transparent);
  }

  .hero-copy h1 {
    margin: 14px 0 0;
    color: #fff;
    font-size: clamp(24px, 3.6cqi + 12px, 36px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .location {
    margin: 12px 0 0;
    color: rgb(255 255 255 / 0.6);
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
  }

  .panels {
    position: absolute;
    z-index: 2;
    right: 28px;
    bottom: 30px;
    display: grid;
    width: 300px;
  }

  .panel {
    grid-area: 1 / 1;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 16px;
    background: rgb(10 11 20 / 0.5);
    padding: 20px 22px;
    opacity: 0;
    color: #fff;
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    transform: translateY(14px);
    transition: opacity 420ms cubic-bezier(0.2, 0.8, 0.2, 1), transform 420ms cubic-bezier(0.2, 0.8, 0.2, 1);
    pointer-events: none;
  }

  .screen:has(#page01-rutas:checked) .panel[data-panel='rutas'],
  .screen:has(#page01-guias:checked) .panel[data-panel='guias'],
  .screen:has(#page01-equipo:checked) .panel[data-panel='equipo'],
  .screen:has(#page01-reservar:checked) .panel[data-panel='reservar'] {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .panel-eyebrow {
    margin: 0;
    color: color-mix(in srgb, var(--primary-color) 55%, #fff 45%);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .panel-title {
    margin: 8px 0 0;
    font-size: 16.5px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .panel-text {
    margin: 8px 0 0;
    color: rgb(255 255 255 / 0.72);
    font-size: 12.5px;
    line-height: 1.55;
  }

  .panel-stats {
    display: flex;
    gap: 16px;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  .panel-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .panel-stat strong {
    font-size: 14px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .panel-stat span {
    color: rgb(255 255 255 / 0.55);
    font-size: 10.5px;
  }

  .panel-cta {
    display: inline-flex;
    margin-top: 16px;
    border-radius: 10px;
    background: var(--primary-color);
    padding: 10px 16px;
    color: var(--primary-contrast);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 180ms ease;
  }

  .panel-cta:hover {
    background: var(--primary-hover);
  }

  @container preview (max-width: 860px) {
    .panels {
      width: 260px;
    }

    .hero-copy {
      max-width: 24ch;
    }
  }

  @container preview (max-width: 640px) {
    .screen {
      height: auto;
      border-radius: 16px;
    }

    .header,
    .hero-copy,
    .panels {
      position: static;
    }

    .header {
      flex-wrap: wrap;
      gap: 10px;
      padding: 18px 18px 14px;
    }

    .nav {
      width: 100%;
      justify-content: space-between;
    }

    .tab-item label {
      padding: 8px 10px;
      font-size: 12px;
    }

    .hero-copy {
      max-width: none;
      padding: 18px 18px 0;
    }

    .panels {
      width: auto;
      padding: 22px 18px 26px;
    }
  }
</style>
