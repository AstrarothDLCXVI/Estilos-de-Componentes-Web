---
// Tienda online autocontenida: header con carrito, banner de campaña,
// categorías, rejilla de producto y franja de garantías. Las fotos son
// degradados en CSS teñidos con el color principal, igual que en cards/.
const categories = ['Novedades', 'Chaquetas', 'Calzado', 'Accesorios', 'Rebajas'];

const products = [
  { name: 'Chaqueta Fjord', price: '89 €', tone: 0, badge: 'Nuevo' },
  { name: 'Botas Talus', price: '124 €', tone: 0.3, badge: null },
  { name: 'Mochila Aire 20L', price: '69 €', tone: 0.6, badge: 'Últimas unidades' },
  { name: 'Gorro Merino', price: '24 €', tone: 1, badge: null },
];

const perks = [
  { title: 'Envío gratis desde 50 €', text: 'Entrega en 24-48 h en península.' },
  { title: 'Devolución en 30 días', text: 'Sin preguntas, sin letra pequeña.' },
  { title: 'Pago seguro', text: 'Tarjeta, PayPal o financiación en 3 plazos.' },
];
---

<div class="site">
  <header class="header">
    <a class="logo" href="#">Nómada Store</a>

    <nav class="nav" aria-label="Principal">
      <ul role="list">
        {categories.map((cat) => <li><a href="#">{cat}</a></li>)}
      </ul>
    </nav>

    <div class="header-actions">
      <button type="button" class="icon-btn" aria-label="Buscar">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <circle cx="7" cy="7" r="4.3"></circle>
          <path d="m13 13-2.6-2.6" stroke-linecap="round"></path>
        </svg>
      </button>
      <button type="button" class="icon-btn" aria-label="Cuenta">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <circle cx="8" cy="5.4" r="2.6"></circle>
          <path d="M2.8 13.4c.9-2.5 2.9-3.8 5.2-3.8s4.3 1.3 5.2 3.8" stroke-linecap="round"></path>
        </svg>
      </button>
      <button type="button" class="icon-btn cart-btn" aria-label="Carrito, 2 artículos">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M2.7 3h1.4l.6 8.2a1 1 0 0 0 1 .9h5.9a1 1 0 0 0 1-.85L13.4 6H4.5" stroke-linecap="round" stroke-linejoin="round"></path>
          <circle cx="6.2" cy="13.6" r="0.9"></circle>
          <circle cx="11" cy="13.6" r="0.9"></circle>
        </svg>
        <span class="cart-badge">2</span>
      </button>
    </div>
  </header>

  <section class="banner photo-tone" style="--tone:0.4">
    <div class="banner-copy">
      <p class="eyebrow">Nueva colección</p>
      <h1>El otoño se camina mejor con el equipo adecuado</h1>
      <a class="btn-solid" href="#">Comprar ahora</a>
    </div>
  </section>

  <section class="chips">
    {categories.map((cat, i) => <a class={`chip ${i === 0 ? 'is-active' : ''}`} href="#">{cat}</a>)}
  </section>

  <section class="products" id="novedades">
    <header class="section-head">
      <h2>Novedades</h2>
      <a href="#">Ver todo</a>
    </header>

    <div class="grid">
      {
        products.map((product) => (
          <article class="product">
            <div class="photo-tone product-photo" style={`--tone:${product.tone}`} aria-hidden="true">
              {product.badge && <span class="product-badge">{product.badge}</span>}
              <button type="button" class="quick-add" aria-label={`Añadir ${product.name} al carrito`}>
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M8 3.5v9M3.5 8h9" stroke-linecap="round" />
                </svg>
              </button>
            </div>
            <div class="product-body">
              <h3>{product.name}</h3>
              <p>{product.price}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="perks">
    {
      perks.map((perk) => (
        <div class="perk">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path d="M3.5 8.5 6.5 11.5 12.5 4.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <div>
            <strong>{perk.title}</strong>
            <span>{perk.text}</span>
          </div>
        </div>
      ))
    }
  </section>

  <footer class="footer">
    <span>© 2026 Nómada Store</span>
    <ul role="list">
      <li><a href="#">Envíos</a></li>
      <li><a href="#">Devoluciones</a></li>
      <li><a href="#">Contacto</a></li>
    </ul>
  </footer>
</div>

<style>
  .site {
    background: var(--background-color);
    font-family: var(--font-sans);
  }

  .photo-tone {
    position: relative;
    overflow: hidden;
    background: linear-gradient(
      calc((130 + var(--tone) * 80) * 1deg),
      color-mix(in srgb, var(--primary-color) 88%, #000 4%),
      color-mix(in srgb, var(--primary-color) 30%, var(--surface-alt))
    );
  }

  .photo-tone::after {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(255 255 255 / 0.2) 1px, transparent 1px);
    background-size: 12px 12px;
    content: '';
  }

  /* --- Header --- */
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1px solid var(--border-color);
    padding: 16px 28px;
  }

  .logo {
    color: var(--text-color);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .nav ul {
    display: flex;
    gap: 22px;
    margin: 0;
    list-style: none;
    padding: 0;
  }

  .nav a {
    color: var(--text-muted);
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .nav a:hover {
    color: var(--text-color);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .icon-btn {
    position: relative;
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border-radius: 999px;
    color: var(--text-muted);
    transition: background-color 180ms ease, color 180ms ease;
  }

  .icon-btn:hover {
    background: var(--surface-alt);
    color: var(--text-color);
  }

  .icon-btn svg {
    width: 16px;
    height: 16px;
  }

  .cart-badge {
    position: absolute;
    top: 3px;
    right: 3px;
    display: grid;
    min-width: 15px;
    height: 15px;
    place-items: center;
    border-radius: 999px;
    background: var(--primary-color);
    color: var(--primary-contrast);
    font-size: 9px;
    font-weight: 700;
  }

  /* --- Banner --- */
  .banner {
    display: flex;
    align-items: center;
    min-height: 320px;
    padding: 40px 28px;
  }

  .banner-copy {
    max-width: 460px;
  }

  .banner .eyebrow {
    margin: 0;
    color: rgb(255 255 255 / 0.85);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .banner h1 {
    margin: 12px 0 0;
    color: #fff;
    font-size: clamp(24px, 3.4cqi + 14px, 36px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .btn-solid {
    display: inline-block;
    margin-top: 22px;
    border-radius: 10px;
    background: #fff;
    padding: 11px 20px;
    color: #101116;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 180ms ease;
  }

  .btn-solid:hover {
    transform: translateY(-1px);
  }

  /* --- Chips de categoría --- */
  .chips {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    border-bottom: 1px solid var(--border-color);
    padding: 16px 28px;
  }

  .chip {
    flex: none;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    padding: 7px 14px;
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 180ms ease, color 180ms ease;
  }

  .chip:hover {
    border-color: var(--primary-color);
    color: var(--text-color);
  }

  .chip.is-active {
    border-color: var(--primary-color);
    background: var(--primary-light);
    color: color-mix(in srgb, var(--primary-color) 78%, var(--text-color));
  }

  /* --- Productos --- */
  .products {
    max-width: 1120px;
    margin-inline: auto;
    padding: 40px 28px 60px;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .section-head h2 {
    margin: 0;
    color: var(--text-color);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .section-head a {
    color: var(--primary-color);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
  }

  .grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr));
  }

  .product-photo {
    position: relative;
    display: grid;
    aspect-ratio: 4 / 5;
    border-radius: 14px;
  }

  .product-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    border-radius: 999px;
    background: rgb(10 11 15 / 0.55);
    padding: 4px 10px;
    color: #fff;
    font-size: 10.5px;
    font-weight: 600;
    backdrop-filter: blur(4px);
  }

  .quick-add {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border-radius: 999px;
    background: #fff;
    color: #101116;
    box-shadow: 0 6px 16px -6px rgb(0 0 0 / 0.4);
    transition: transform 180ms ease;
  }

  .quick-add:hover {
    transform: scale(1.08);
  }

  .quick-add svg {
    width: 14px;
    height: 14px;
  }

  .product-body {
    padding-top: 12px;
  }

  .product-body h3 {
    margin: 0;
    color: var(--text-color);
    font-size: 14px;
    font-weight: 600;
  }

  .product-body p {
    margin: 5px 0 0;
    color: var(--text-muted);
    font-size: 13.5px;
    font-variant-numeric: tabular-nums;
  }

  /* --- Garantías --- */
  .perks {
    display: grid;
    gap: 20px;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 28px 60px;
    grid-template-columns: repeat(3, 1fr);
  }

  .perk {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    border: 1px solid var(--border-color);
    border-radius: 14px;
    background: var(--surface-color);
    padding: 16px;
  }

  .perk svg {
    width: 17px;
    height: 17px;
    flex: none;
    margin-top: 2px;
    color: var(--primary-color);
  }

  .perk strong {
    display: block;
    color: var(--text-color);
    font-size: 13.5px;
    font-weight: 600;
  }

  .perk span {
    display: block;
    margin-top: 3px;
    color: var(--text-muted);
    font-size: 12px;
  }

  /* --- Footer --- */
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid var(--border-color);
    padding: 20px 28px;
    color: var(--text-muted);
    font-size: 12.5px;
  }

  .footer ul {
    display: flex;
    gap: 18px;
    margin: 0;
    list-style: none;
    padding: 0;
  }

  .footer a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--text-color);
  }

  @container preview (max-width: 700px) {
    .header {
      flex-wrap: wrap;
      padding: 14px 18px;
    }

    .nav {
      order: 3;
      width: 100%;
    }

    .nav ul {
      gap: 14px;
      overflow-x: auto;
    }

    .products,
    .perks {
      padding-inline: 18px;
    }

    .perks {
      grid-template-columns: 1fr;
    }

    .chips {
      padding-inline: 18px;
    }
  }
</style>
